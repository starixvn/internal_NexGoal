@using NexGoal.Model.EmployeeEPA
@using NexGoal.Model.Export
@using NexGoal.Model.Integration
@using NexGoal.Resources

@model EpaDetailModel
@{
    Layout = null;
    var hrm = Model.Hrm;
    var epa = Model.Epa;
    var grades = Model.Grades;
    var count = 0;
    var countGroupKPI = 0;
    var numberEvaluator = epa.Process.Evaluators.Count;
    var numberReviewer = epa.Process.Reviewers.Count;
}

<html>
<head>
    <meta charset="utf-8" />
    @Styles.Render("~/Content/EpaDetail/css")
</head>
<body>
    <div class="container">
        <div class="title-page">PERFORMANCE APPRAISAL (@epa.Period.Name)</div>
        <div class="title2">Information Profile</div>
        <div class="dashboard">
            <div class="panel-body">
                <div class="img-user">
                    <img class="img-default" src="@epa.Employee.Avatar" />
                </div>
                <div class="info-user">
                    <div class="row-item">
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.EmployeeCode</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.Code</span>
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.NickName</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.NickName</span>
                            </div>
                        </div>
                    </div>
                    <div class="row-item">
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.FullName</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.FullName</span>
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.JobTitle</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.JobTitleName</span>
                            </div>
                        </div>
                    </div>
                    <div class="row-item">
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.Department</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.DepartmentName</span>
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.Team</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.GroupName</span>
                            </div>
                        </div>
                    </div>
                    <div class="row-item">
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.JoinedDate</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.JoinedDate.ToString("dd MMM, yyyy")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="title2">The Rating Scale</div>
        <table class="rating-instruction">

            <tr class="title-table">
                <td>
                    <p>Poor: 1 </p>
                    <p class="star-block">
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                    </p>
                </td>
                <td>
                    <p>Below Average: 2 </p>

                    <p class="star-block">
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                    </p>
                </td>
                <td>
                    <p>Satisfactory: 3</p>

                    <p class="star-block">
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                    </p>
                </td>
                <td>
                    <p>Good: 4</p>
                    <p class="star-block">
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                    </p>
                </td>
                <td>
                    <p>Excellent: 5</p>
                    <p class="star-block">
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                    </p>
                </td>
            </tr>
        </table>


        <div class="title2">Evaluation Process</div>
        <table>
            <thead>
                <tr class="title-table">
                    <td class="title-table">#</td>
                    <td>Evaluation Step</td>
                    <td>Name</td>
                    <td>Start Date</td>
                    <td>End Date</td>
                </tr>
            </thead>
            <tr class="content-table">
                <td class="content-table">1</td>
                <td>@Lang.Admin</td>
                <td>
                    @foreach (var hr in epa.Process.HumanResources)
                    {
                    <p>@hr.NickName</p>
                    }
                </td>
                <td>@epa.Process.HumanResources[0].StartDate.ToString("dd MMM, yyyy ")</td>
                <td>@epa.Process.HumanResources[0].EndDate.ToString("dd MMM, yyyy ")</td>
            </tr>
            <tr class="title-table">
                <td class="content-table">2</td>
                <td>Self</td>
                <td>@epa.Process.Self.NickName</td>
                <td>@epa.Process.Self.StartDate.ToString("dd MMM, yyyy ")</td>
                <td>@epa.Process.Self.EndDate.ToString("dd MMM, yyyy ")</td>
            </tr>
            <tr class="title-table">
                <td class="content-table">3</td>
                <td>@Lang.Evaluator</td>
                <td>
                    @foreach (var pepole in epa.Process.Evaluators)
                    {
                    <p>@pepole.NickName</p>
                    }
                </td>
                <td>@epa.Process.Evaluators[0].StartDate.ToString("dd MMM, yyyy ")</td>
                <td>@epa.Process.Evaluators[0].EndDate.ToString("dd MMM, yyyy ")</td>
            </tr>
            <tr class="title-table">
                <td class="content-table">4</td>
                <td>@Lang.Reviewer</td>
                <td>
                    @foreach (var pepole in epa.Process.Reviewers)
                    {
                    <p>@pepole.NickName</p>
                    }
                </td>
                <td>@epa.Process.Reviewers[0].StartDate.ToString("dd MMM, yyyy ")</td>
                <td>@epa.Process.Reviewers[0].EndDate.ToString("dd MMM, yyyy ")</td>
            </tr>
        </table>

        <div class="title0">@Lang.ApproachToWork</div>
        <div class="title1">@Lang.HRMSystem</div>
        <table>
            <thead>
                <tr class="title-table">
                    <td class="width-medium">Month</td>
                    <td>@Lang.CheckInOut</td>
                    <td>@Lang.LateIn</td>
                    <td>@Lang.EarlyOut</td>
                    <td>@Lang.UnpaidLeave</td>
                    <td>@Lang.UnplannedAnnualLeave</td>
                    <td>@Lang.AverageWorkingHours</td>
                    <td class="width-medium">@Lang.Overtime</td>
                    <td>@Lang.ToeicScore</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in hrm)
            {
                    <tr class="content-table">
                        <td>@item.Month/@item.Year</td>
                        <td>@item.NumberMissingCheckInOut</td>
                        <td>@item.NumberLateIn</td>
                        <td>@item.NumberEarlyOut</td>
                        <td>@item.NumberUnpaidLeave</td>
                        <td>@item.NumberUnplannedAnnualLeave</td>
                        <td>@FormatWorkingHours(item.AverageWorkingHours)</td>
                        <td>@item.NumberOvertime</td>
                        @if (count == 0)
                        {
                            count++;
                            <td rowspan="@(hrm.Count()+1)">
                                @if (item.UpdatedDateTOEIC.HasValue)
                                {
                                    @(item.ListeningScore + item.ReadingScore)
                                    <br />
                                    if (item.UpdatedDateTOEIC.HasValue)
                                    {
                                        @("(" + item.UpdatedDateTOEIC.Value.ToString("dd MMM, yyyy ") + ")")
                                    }
                                }
                                else
                                {
                                    @Lang.Dash
                                }
                            </td>
                        }

                    </tr>
                }

                <tr class="sub-total title-table">
                    <td>Total</td>
                    <td>@hrm.Sum(i => i.NumberMissingCheckInOut)</td>
                    <td>@hrm.Sum(i => i.NumberLateIn)</td>
                    <td>@hrm.Sum(i => i.NumberUnpaidLeave)</td>
                    <td>@hrm.Sum(i => i.NumberEarlyOut)</td>
                    <td>@hrm.Sum(i => i.NumberUnplannedAnnualLeave)</td>
                    <td>@FormatWorkingHours(hrm.Average(i => i.AverageWorkingHours))</td>
                    <td>@hrm.Sum(i => i.NumberOvertime)</td>
                </tr>
            </tbody>
        </table>

        <div class="title0">@Lang.PerformanceResult</div>
        <div class="title1">A. Result Detail</div>
        @foreach (var group in epa.KPIGroups)
        {
            count = 0;
            countGroupKPI++;
            <div class="title2">@countGroupKPI. @group.Name (@group.Weight pts)</div>
            <table>
                <thead class="title-table">
                    <tr>
                        <td rowspan="1" class="width05">@Lang.No</td>
                        <td class="width75">@Lang.KPI</td>
                        <td class="width10 content-table-left">
                            Self
                        </td>
                        <td class="width10 content-table-left">
                            @Lang.Evaluator
                        </td>
                        @if (numberEvaluator > 1)
                        {
                            <td class="width10 content-table-left">
                                @Lang.Score/<img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                            </td>
                        }
                    </tr>
                </thead>
                @foreach (var kpi in group.KPIs)
                {
                    count++;
                    <tr>
                        <td rowspan="@(numberEvaluator+1)" class="content-table width-small">@count</td>
                        <td rowspan="@numberEvaluator" class="content-table-left"><strong>@kpi.Name (@Math.Round(kpi.Weight, 2) pts) </strong></td>

                        @if (kpi.EvaluationBySelf.Score == 0)
                        {
                            <td rowspan="@numberEvaluator" class="content-table width-medium">
                                @(Lang.Dash)
                            </td>
                        }
                        else
                        {
                            <td rowspan="@numberEvaluator" class="content-table-left width-medium">
                                @(Math.Round(kpi.EvaluationBySelf.Score, 2) + "/" + kpi.EvaluationBySelf.Rate)
                                <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                            </td>
                        }


                        @if (numberEvaluator > 1)
                        {
                            <td class="content-table width-medium">
                                @kpi.EvaluationByEvaluators[0].NickName
                            </td>
                        }

                        @if (kpi.EvaluationByEvaluators[0].Score == 0)
                        {
                            <td class="content-table width-medium">
                                @(Lang.Dash)
                            </td>
                        }
                        else
                        {
                            <td class="content-table-left width-medium">
                                @(Math.Round(kpi.EvaluationByEvaluators[0].Score, 2) + "/" + kpi.EvaluationByEvaluators[0].Rate)
                                <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                            </td>
                        }

                    </tr>

                    for (int i = 1; i < kpi.EvaluationByEvaluators.Count; i++)
                    {
                        <tr>
                            <td class="content-table width-medium">
                                @kpi.EvaluationByEvaluators[i].NickName
                            </td>

                            @if (kpi.EvaluationByEvaluators[0].Score == 0)
                            {
                                <td class="content-table width-medium">
                                    @(Lang.Dash)
                                </td>
                            }
                            else
                            {
                                <td class="content-table-left width-medium">
                                    @(Math.Round(kpi.EvaluationByEvaluators[i].Score, 2) + "/" + kpi.EvaluationByEvaluators[i].Rate)
                                    <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />

                                </td>
                            }
                        </tr>
                    }

                    <tr>
                        <td colspan="@(3+(numberEvaluator>1?1:0))" class="content-table-left">
                            @if (!string.IsNullOrEmpty(kpi.EvaluationBySelf.Comment))
                            {
                                <span>Self:</span>
                                <span class="comment">@kpi.EvaluationBySelf.Comment</span>
                            }

                            @foreach (var evaluator in kpi.EvaluationByEvaluators.Where(i => !string.IsNullOrEmpty(i.Comment)))
                            {
                                <br />
                                <br />
                                <span>@Lang.Evaluator (@evaluator.NickName):</span>
                                <span class="comment">@evaluator.Comment</span>
                            }

                        </td>
                    </tr>
                }

                <tr class="sub-total title-table">
                    <td colspan="2">Sub Total</td>

                    @if (group.KPIs.Sum(i => i.EvaluationBySelf.Score) == 0)
                    {
                        <td>
                            @(Lang.Dash)
                        </td>
                    }
                    else
                    {
                        <td class="content-table-left">
                            @(Math.Round(group.KPIs.Sum(i => i.EvaluationBySelf.Score), 2) + "/" + group.Weight)
                        </td>
                    }



                    @if (group.KPIs.Sum(i => i.EvaluationByEvaluators.Average(j => j.Score)) == 0)
                    {
                        <td colspan="@(1+(numberEvaluator>1?1:0))">
                            @(Lang.Dash)
                        </td>
                    }
                    else
                    {
                        <td colspan="@(1+(numberEvaluator>1?1:0))" class="content-table-left">
                            @(Math.Round(group.KPIs.Sum(i => i.EvaluationByEvaluators.Average(j => j.Score)), 2) + "/" + group.Weight)
                        </td>
                    }

                </tr>

            </table>
        }

        <div class="title1">B. Result Summary</div>
        <table class="Result-table">
            <tbody>
                <tr class="content-table-left evaluator-step">
                    <td colspan="3">1. Self</td>
                </tr>
                <tr class="content-table">
                    <td>@epa.Process.Self.NickName</td>
                    <td>@(string.IsNullOrEmpty(epa.Process.Self.TotalScore) ? Lang.Dash : Math.Round(float.Parse(epa.Process.Self.TotalScore)).ToString())</td>
                    <td>@GetGradeRange(epa.Process.Self.TotalScore, grades)</td>
                </tr>
                <tr>
                    <td colspan="3" class="content-table-left comment">
                        @epa.Process.Self.Comment
                    </td>
                </tr>

                <tr class="content-table-left evaluator-step">
                    <td colspan="3">2. @Lang.Evaluator</td>
                </tr>
                <tr class="content-table">
                    <td>@epa.Process.Evaluators[0].NickName</td>
                    <td>@(string.IsNullOrEmpty(epa.Process.Evaluators[0].TotalScore) ? Lang.Dash : Math.Round(float.Parse(epa.Process.Evaluators[0].TotalScore)).ToString())</td>
                    <td>@GetGradeRange(epa.Process.Evaluators[0].TotalScore, grades)</td>
                </tr>
                <tr>
                    <td colspan="3" class="content-table-left comment">
                        @epa.Process.Evaluators[0].Comment
                    </td>
                </tr>

                @for (int i = 1; i < numberEvaluator; i++)
                {
                    <tr class="content-table">
                        <td>@epa.Process.Evaluators[i].NickName</td>
                        <td>@(int.Parse(epa.Process.Evaluators[i].TotalScore).ToString())</td>
                        <td>@GetGradeRange(epa.Process.Evaluators[i].TotalScore, grades)</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="content-table-left comment">
                            @epa.Process.Evaluators[i].Comment
                        </td>
                    </tr>
                }

                <tr class="content-table-left evaluator-step">
                    <td colspan="3">3. @Lang.Reviewer</td>
                </tr>

                <tr class="content-table">
                    <td>@epa.Process.Reviewers[0].NickName</td>
                    <td colspan="2">@(string.IsNullOrEmpty(epa.Process.Reviewers[0].AdjustScore) ? Lang.Dash : Math.Round(float.Parse(epa.Process.Reviewers[0].AdjustScore)) > 0 ? "+" + epa.Process.Reviewers[0].AdjustScore : epa.Process.Reviewers[0].AdjustScore)</td>
                </tr>
                <tr>
                    <td colspan="3" class="content-table-left comment">
                        @epa.Process.Reviewers[0].Comment
                    </td>
                </tr>
                @for (int i = 1; i < numberReviewer; i++)
                {
                    <tr class="content-table">
                        <td>@epa.Process.Reviewers[i].NickName</td>
                        <td colspan="2"s>@(string.IsNullOrEmpty(epa.Process.Reviewers[i].AdjustScore) ? Lang.Dash : Math.Round(float.Parse(epa.Process.Reviewers[i].AdjustScore)) > 0 ? "+" + epa.Process.Reviewers[i].AdjustScore : epa.Process.Reviewers[i].AdjustScore)</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="content-table-left comment">
                            @epa.Process.Reviewers[i].Comment
                        </td>
                    </tr>
                }

                <tr class="sub-total title-table">
                    <td>Final Score</td>
                    <td>@(epa.FinalScore == "0" ? Lang.Dash : epa.FinalScore)</td>
                    <td>@(epa.FinalScore == "0" ? Lang.Dash : epa.Grade)</td>
                </tr>
            </tbody>

        </table>

        <table class="grade-table">
            <tr>
                @foreach (var grade in grades)
                {
                    <td>@grade.Code. @grade.Name: @grade.LeftScore ~ @grade.RightScore</td>
                }
            </tr>

        </table>
    </div>

</body>
</html>
@helper FormatWorkingHours(double value)
        {
var hour = (int)value;
var hourStr = hour.ToString();
if (hour < 10)
{
    hourStr = "0" + hourStr;
}
hourStr += "h";
var minute = Math.Round(((value - hour) * 60));
var minuteStr = minute.ToString();
if (minute < 10)
{
    minuteStr = "0" + minuteStr;
}
minuteStr += "'";

    <span>@(hourStr + minuteStr)</span>
}

@helper GetGradeRange(string scoreStr, IEnumerable<StandardGradeModel> grades)
{
if (string.IsNullOrEmpty(scoreStr))
{
        <span>@Lang.Dash</span>
}
else
{
    float score = float.Parse(scoreStr);

    foreach (var grade in grades)
    {
        if (score >= grade.LeftScore && score <= grade.RightScore)
        {
                <span>@grade.Code</span>
        }

    }
}

}