@using NexGoal.Model.EmployeeEPA
@using NexGoal.Core.Enumerations
@using NexGoal.Model.Export
@using NexGoal.Model.Integration
@using NexGoal.Resources

@model EpaDetailModel
@{
    Layout = null;
    var hrm = Model.Hrm;
    var epa = Model.Epa;
    var grades = Model.Grades;
    var nominations = Model.Nominations;
    var violations = Model.Violations;
    var nexPMs = Model.NexPMs;
    var lastRatings = Model.LastRatings;
    var count = 0;
    var countGroupKPI = 0;
    var numberEvaluator = epa.Process.Evaluators.Count;
    var numberReviewer = epa.Process.Reviewers.Count;
}

<html>
<head>
    <meta charset="utf-8" />
    @Styles.Render("~/Content/EpaDetail/css")
</head>
<body>
    <div class="container">
        <div class="title-page">PERFORMANCE APPRAISAL (@epa.Period.Name)</div>
        <div class="title2">Information Profile</div>
        <div class="dashboard">
            <div class="panel-body">
                <div class="img-user">
                    <img class="img-default" src="@epa.Employee.Avatar" />
                </div>
                <div class="info-user">
                    <div class="row-item">
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.EmployeeCode</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.Code</span>
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.NickName</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.NickName</span>
                            </div>
                        </div>
                    </div>
                    <div class="row-item">
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.FullName</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.FullName</span>
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.JobTitle</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.JobTitleName</span>
                            </div>
                        </div>
                    </div>
                    <div class="row-item">
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.Department</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.DepartmentName</span>
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.Team</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.GroupName</span>
                            </div>
                        </div>
                    </div>
                    <div class="row-item">
                        <div class="info-item">
                            <div class="info-label"><strong>@Lang.JoinedDate</strong></div>
                            <div class="info-detail">
                                <span>@epa.Employee.JoinedDate.ToString("dd MMM, yyyy")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="title2">The Rating Scale</div>
        <table class="rating-instruction">

            <tr class="title-table">
                <td>
                    <p>Poor: 1 </p>
                    <p class="star-block">
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                    </p>
                </td>
                <td>
                    <p>Below Average: 2 </p>

                    <p class="star-block">
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                    </p>
                </td>
                <td>
                    <p>Satisfactory: 3</p>

                    <p class="star-block">
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                    </p>
                </td>
                <td>
                    <p>Good: 4</p>
                    <p class="star-block">
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                    </p>
                </td>
                <td>
                    <p>Excellent: 5</p>
                    <p class="star-block">
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                        <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                    </p>
                </td>
            </tr>
        </table>


        <div class="title2">Evaluation Process</div>
        <table>
            <thead>
                <tr class="title-table">
                    <td class="title-table">#</td>
                    <td>Evaluation Step</td>
                    <td>Name</td>
                    <td>Start Date</td>
                    <td>End Date</td>
                </tr>
            </thead>
            <tr class="content-table">
                <td class="content-table">1</td>
                <td>@Lang.Admin</td>
                <td>
                    @foreach (var hr in epa.Process.HumanResources)
                    {
                    <p>@hr.NickName</p>
                    }
                </td>
                <td>@epa.Process.HumanResources[0].StartDate.ToString("dd MMM, yyyy ")</td>
                <td>@epa.Process.HumanResources[0].EndDate.ToString("dd MMM, yyyy ")</td>
            </tr>
            <tr class="title-table">
                <td class="content-table">2</td>
                <td>Self</td>
                <td>@epa.Process.Self.NickName</td>
                <td>@epa.Process.Self.StartDate.ToString("dd MMM, yyyy ")</td>
                <td>@epa.Process.Self.EndDate.ToString("dd MMM, yyyy ")</td>
            </tr>
            <tr class="title-table">
                <td class="content-table">3</td>
                <td>@Lang.Evaluator</td>
                <td>
                    @foreach (var pepole in epa.Process.Evaluators)
                    {
                    <p>@pepole.NickName</p>
                    }
                </td>
                <td>@epa.Process.Evaluators[0].StartDate.ToString("dd MMM, yyyy ")</td>
                <td>@epa.Process.Evaluators[0].EndDate.ToString("dd MMM, yyyy ")</td>
            </tr>
            <tr class="title-table">
                <td class="content-table">4</td>
                <td>@Lang.Reviewer</td>
                <td>
                    @foreach (var pepole in epa.Process.Reviewers)
                    {
                    <p>@pepole.NickName</p>
                    }
                </td>
                <td>@epa.Process.Reviewers[0].StartDate.ToString("dd MMM, yyyy ")</td>
                <td>@epa.Process.Reviewers[0].EndDate.ToString("dd MMM, yyyy ")</td>
            </tr>
        </table>

        <div class="title0">@Lang.ApproachToWork</div>
        <div class="title1">A. @Lang.HRMSystem</div>
        <table>
            <thead>
                <tr class="title-table">
                    <td class="width-medium">Month</td>
                    <td>@Lang.CheckInOut</td>
                    <td>@Lang.LateIn</td>
                    <td>@Lang.EarlyOut</td>
                    <td>@Lang.UnpaidLeave</td>
                    <td>@Lang.UnplannedAnnualLeave</td>
                    <td>@Lang.AverageWorkingHours</td>
                    <td class="width-medium">@Lang.Overtime</td>
                    <td>@Lang.ToeicScore</td>
                </tr>
            </thead>
            <tbody>
    @foreach (var item in hrm)
            {
        <tr class="content-table">
            <td>@item.Month/@item.Year</td>
            <td>@item.NumberMissingCheckInOut</td>
            <td>@item.NumberLateIn</td>
            <td>@item.NumberEarlyOut</td>
            <td>@item.NumberUnpaidLeave</td>
            <td>@item.NumberUnplannedAnnualLeave</td>
            <td>@FormatWorkingHours(item.AverageWorkingHours)</td>
            <td>@item.NumberOvertime</td>
            @if (count == 0)
            {
                count++;
                <td rowspan="@(hrm.Count()+1)">
                    @if (item.UpdatedDateTOEIC.HasValue)
                    {
                        @(item.ListeningScore + item.ReadingScore)
                        <br />
                        if (item.UpdatedDateTOEIC.HasValue)
                        {
                            @("(" + item.UpdatedDateTOEIC.Value.ToString("dd MMM, yyyy") + ")")
                        }
                    }
                    else
                    {
                        @Lang.Dash
                    }
                </td>
            }

        </tr>
    }
    @if (hrm.Any())
    {
        <tr class="sub-total title-table">
            <td>Total</td>
            <td>@hrm.Sum(i => i.NumberMissingCheckInOut)</td>
            <td>@hrm.Sum(i => i.NumberLateIn)</td>
            <td>@hrm.Sum(i => i.NumberUnpaidLeave)</td>
            <td>@hrm.Sum(i => i.NumberEarlyOut)</td>
            <td>@hrm.Sum(i => i.NumberUnplannedAnnualLeave)</td>
            <td>@FormatWorkingHours(hrm.Select(i => i.AverageWorkingHours).DefaultIfEmpty(0).Average())</td>
            <td>@hrm.Sum(i => i.NumberOvertime)</td>
        </tr>
    }
    else
    {
        <tr>
            <td colspan="9" class="empty-result content-table">@Lang.EmptyResult</td>
        </tr>
    }

            </tbody>
        </table>

        <div class="title1">B. @Lang.EmployeeAwards</div>
        <table>
            <thead class="title-table">
                <tr>
                    <td class="width-small">@Lang.SymbolCount</td>
                    <td class="content-table-left width75">@Lang.Title</td>
                    <td class="content-table-left width10">@Lang.Status</td>
                </tr>
            </thead>
            @if (nominations.Any())
            {
                count = 0;
                foreach (var nomination in nominations)
                {
                    count++;
            <tr>
                <td class="content-table">@count</td>
                <td class="content-table-left">@nomination.Title</td>
                <td class="content-table-left nominationStatus-@nomination.StatusId">@nomination.StatusToString</td>
            </tr>
                }
            }
            else
            {
            <tr>
                <td colspan="3" class="empty-result content-table">@Lang.EmptyResult</td>
            </tr>
            }
        </table>

        <div class="title1">C. @Lang.Violation</div>
        <table>
            <thead class="title-table">
                <tr>
                    <td class="content-table width-small">@Lang.SymbolCount</td>
                    <td class="content-table-left width75">@Lang.Remark</td>
                    <td class="content-table-left width10">@Lang.Date</td>
                </tr>
            </thead>
            @if (violations.Any())
            {
                count = 0;
                foreach (var violation in violations)
                {
                    count++;
            <tr>
                <td class="content-table">@count</td>
                <td class="content-table-left">@violation.Description</td>
                <td class="content-table-left">@violation.EffectedDate.ToString("dd MMM, yyyy")</td>
            </tr>
                }
            }
            else
            {
            <tr>
                <td colspan="3" class="empty-result content-table">@Lang.EmptyResult</td>
            </tr>
            }
            <tr></tr>
        </table>

        <div class="title0">@Lang.ForEmployeeUse</div>
        <div class="title1">A. @Lang.ProjectEfficiency</div>
        <table>
            <thead class="title-table">
                <tr>
                    <td class="width-small content-table">@Lang.No</td>
                    <td class="content-table-left width-large">@Lang.ProjectName</td>
                    <td class="content-table-left">@Lang.ProjectManager</td>
                    <td class="content-table-left">@Lang.StartDate</td>
                    <td class="content-table-left">@Lang.EndDate</td>
                    <td class="content-table-left">@Lang.Role</td>
                    <td class="content-table-left width-medium">@Lang.TotalSpendTime</td>
                    <td class="content-table-left width-medium">@Lang.Score</td>
                </tr>
            </thead>
            @if (nexPMs.Count() == 0)
            {
            <tr>
                <td colspan="8" class="empty-result content-table">@Lang.EmptyResult</td>
            </tr>
            }
            else
            {
                count = 0;
                foreach (var item in nexPMs)
                {
                    count++;
            <tr>
                <td class="content-table" rowspan="@(string.IsNullOrEmpty(item.Comment)?1:2)">@count</td>
                <td class="content-table-left" rowspan="@(string.IsNullOrEmpty(item.Comment)?1:2)">@item.ProjectName</td>
                <td class="content-table-left">@item.ProjectManagerName</td>
                <td class="content-table-left">@item.StartDate.ToString("dd MMM, yyyy")</td>
                <td class="content-table-left">@(item.EndDate.HasValue ? item.EndDate.Value.ToString("dd MMM, yyyy") : Lang.Dash)</td>
                <td class="content-table-left">@item.Roles</td>
                <td class="content-table-left">@item.WorkingHour</td>
                <td class="content-table-left">
                    @if (string.IsNullOrEmpty(item.DecryptedScore))
                            {
                            @(Lang.Dash)
                            }
                            else
                            {
                            @(item.DecryptedScore)
                            <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                            }

                </td>
            </tr>
                    if (!string.IsNullOrEmpty(item.Comment))
                    {
            <tr>
                <td colspan="6" class="content-table-left">@item.Comment</td>
            </tr>
                    }
                }
            }

        </table>

        <div class="title0">@Lang.PerformanceResult</div>
        <div class="title1">A. Result Detail</div>
        @foreach (var group in epa.KPIGroups)
        {
            count = 0;
            countGroupKPI++;
            <div class="title2">@countGroupKPI. @group.Name (@group.Weight pts)</div>
            <table>
                <thead class="title-table">
                    <tr>
                        <td rowspan="1" class="width05">@Lang.No</td>
                        <td class="width75">@Lang.KPI</td>
                        <td class="width10 content-table-left">
                            Self
                        </td>
                        <td class="width10 content-table-left">
                            @Lang.Evaluator
                        </td>
                        @if (numberEvaluator > 1)
                        {
                            <td class="width10 content-table-left">
                                @Lang.Score/<img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                            </td>
                        }

                        @if (lastRatings.Any())
                        {
                            <td class="width10 content-table-left">Last Rating</td>
                        }
                    </tr>
                </thead>
                @foreach (var kpi in group.KPIs)
                {
                    count++;
                    <tr>
                        <td rowspan="@(numberEvaluator+1)" class="content-table width-small">@count</td>
                        <td rowspan="@numberEvaluator" class="content-table-left"><strong>@kpi.Name (@Math.Round(kpi.Weight, 2) pts) </strong></td>

                        @if (kpi.EvaluationBySelf.Score == 0)
                        {
                            <td rowspan="@numberEvaluator" class="content-table width-medium">
                                @(Lang.Dash)
                            </td>
                        }
                        else
                        {
                            <td rowspan="@numberEvaluator" class="content-table-left width-medium">
                                @(FormatScore(kpi.EvaluationBySelf.Score) + "/" + kpi.EvaluationBySelf.Rate)
                                <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                            </td>
                        }


                        @if (numberEvaluator > 1)
                        {
                            <td class="content-table width-medium">
                                @kpi.EvaluationByEvaluators[0].NickName
                            </td>
                        }

                        @if (kpi.EvaluationByEvaluators[0].Score == 0)
                        {
                            <td class="content-table width-medium">
                                @(Lang.Dash)
                            </td>
                        }
                        else
                        {
                            <td class="content-table-left width-medium">
                                @(FormatScore(kpi.EvaluationByEvaluators[0].Score) + "/" + kpi.EvaluationByEvaluators[0].Rate)
                                <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />
                            </td>
                        }

                        @if (lastRatings.Any())
                        {
                            @LastRating(lastRatings, kpi.KPIGroupId, kpi.KPIId, numberEvaluator)
                        }
                    </tr>

                    for (int i = 1; i < kpi.EvaluationByEvaluators.Count; i++)
                    {
                        <tr>
                            <td class="content-table width-medium">
                                @kpi.EvaluationByEvaluators[i].NickName
                            </td>

                            @if (kpi.EvaluationByEvaluators[0].Score == 0)
                            {
                                <td class="content-table width-medium">
                                    @(Lang.Dash)
                                </td>
                            }
                            else
                            {
                                <td class="content-table-left width-medium">
                                    @(FormatScore(kpi.EvaluationByEvaluators[i].Score) + "/" + kpi.EvaluationByEvaluators[i].Rate)
                                    <img class="star" src="@Server.MapPath("~/Content/Site/Components/images/star.png")" />

                                </td>
                            }
                        </tr>
                    }

                    <tr>
                        <td colspan="@(3+(numberEvaluator>1?1:0))" class="content-table-left">
                            @if (!string.IsNullOrEmpty(kpi.EvaluationBySelf.Comment))
                            {
                                <span>Self:</span>
                                <span class="comment">@kpi.EvaluationBySelf.Comment</span>
                            }

                            @foreach (var evaluator in kpi.EvaluationByEvaluators.Where(i => !string.IsNullOrEmpty(i.Comment)))
                            {
                                <br />
                                <br />
                                <span>@Lang.Evaluator (@evaluator.NickName):</span>
                                <span class="comment">@evaluator.Comment</span>
                            }

                        </td>
                    </tr>
                }

                <tr class="sub-total title-table">
                    <td colspan="2">Sub Total</td>

                    @if (group.KPIs.Sum(i => i.EvaluationBySelf.Score) == 0)
                    {
                        <td>
                            @(Lang.Dash)
                        </td>
                    }
                    else
                    {
                        <td class="content-table-left">
                            @(group.KPIs.Sum(i => FormatScore(i.EvaluationBySelf.Score)) + "/" + group.Weight)
                        </td>
                    }

                    @if (group.KPIs.Sum(i => i.EvaluationByEvaluators.Average(j => j.Score)) == 0)
                    {
                        <td colspan="@(1+(numberEvaluator>1?1:0))">
                            @(Lang.Dash)
                        </td>
                    }
                    else
                    {
                        <td colspan="@(1+(numberEvaluator>1?1:0))" class="content-table-left">
                            @(group.KPIs.Sum(i => FormatScore(i.EvaluationByEvaluators.Average(j => j.Score))) + "/" + group.Weight)
                        </td>
                    }

                    @if (lastRatings.Any())
                    {
                        @SubtotalLastRating(lastRatings, group.KPIGroupId)
                    }
                </tr>

            </table>
        }

        <div class="title1">B. Result Summary</div>
        <table class="Result-table">
            <tbody>
                <tr class="content-table-left evaluator-step">
                    <td colspan="3">1. Self</td>
                </tr>
                <tr class="content-table">
                    <td>@epa.Process.Self.NickName</td>
                    <td>@(string.IsNullOrEmpty(epa.Process.Self.TotalScore) ? Lang.Dash : Math.Round(float.Parse(epa.Process.Self.TotalScore)).ToString())</td>
                    <td>@GetGradeRange(epa.Process.Self.TotalScore, grades)</td>
                </tr>
                <tr>
                    <td colspan="3" class="content-table-left comment">
                        @epa.Process.Self.Comment
                    </td>
                </tr>

                <tr class="content-table-left evaluator-step">
                    <td colspan="3">2. @Lang.Evaluator</td>
                </tr>
                <tr class="content-table">
                    <td>@epa.Process.Evaluators[0].NickName</td>
                    <td>@(string.IsNullOrEmpty(epa.Process.Evaluators[0].TotalScore) ? Lang.Dash : Math.Round(float.Parse(epa.Process.Evaluators[0].TotalScore)).ToString())</td>
                    <td>@GetGradeRange(epa.Process.Evaluators[0].TotalScore, grades)</td>
                </tr>
                <tr>
                    <td colspan="3" class="content-table-left comment">
                        @epa.Process.Evaluators[0].Comment
                    </td>
                </tr>

                @for (int i = 1; i < numberEvaluator; i++)
                {
                    <tr class="content-table">
                        <td>@epa.Process.Evaluators[i].NickName</td>
                        <td>@(string.IsNullOrEmpty(epa.Process.Evaluators[i].TotalScore) ? Lang.Dash : Math.Round(float.Parse(epa.Process.Evaluators[i].TotalScore)).ToString())</td>
                        <td>@GetGradeRange(epa.Process.Evaluators[i].TotalScore, grades)</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="content-table-left comment">
                            @epa.Process.Evaluators[i].Comment
                        </td>
                    </tr>
                }

                <tr class="content-table-left evaluator-step">
                    <td colspan="3">3. @Lang.Reviewer</td>
                </tr>

                <tr class="content-table">
                    <td>@epa.Process.Reviewers[0].NickName</td>
                    <td colspan="2">@(string.IsNullOrEmpty(epa.Process.Reviewers[0].AdjustScore) ? Lang.Dash : Math.Round(float.Parse(epa.Process.Reviewers[0].AdjustScore)) >= 0 ? "+" + epa.Process.Reviewers[0].AdjustScore : epa.Process.Reviewers[0].AdjustScore)</td>
                </tr>
                <tr>
                    <td colspan="3" class="content-table-left comment">
                        @epa.Process.Reviewers[0].Comment
                    </td>
                </tr>
                @for (int i = 1; i < numberReviewer; i++)
                {
                    <tr class="content-table">
                        <td>@epa.Process.Reviewers[i].NickName</td>
                        <td colspan="2" s>@(string.IsNullOrEmpty(epa.Process.Reviewers[i].AdjustScore) ? Lang.Dash : Math.Round(float.Parse(epa.Process.Reviewers[i].AdjustScore)) >= 0 ? "+" + epa.Process.Reviewers[i].AdjustScore : epa.Process.Reviewers[i].AdjustScore)</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="content-table-left comment">
                            @epa.Process.Reviewers[i].Comment
                        </td>
                    </tr>
                }

                <tr class="sub-total title-table">
                    <td>Final Score</td>
                    <td>@(epa.FinalScore == "0" ? Lang.Dash : epa.FinalScore)</td>
                    <td>@(epa.FinalScore == "0" ? Lang.Dash : epa.Grade)</td>
                </tr>
                <tr class="sub-total title-table">
                    <td>Last Final Score</td>
                    <td>@(epa.LastFinalScore == "0" ? Lang.Dash : epa.LastFinalScore)</td>
                    <td>@(epa.LastFinalScore == "0" ? Lang.Dash : epa.LastGrade)</td>
                </tr>
            </tbody>

        </table>

        <table class="grade-table">
            <tr>
                @foreach (var grade in grades)
                {
                    <td>@grade.Code. @grade.Name: @grade.LeftScore ~ @grade.RightScore</td>
                }
            </tr>

        </table>
    </div>

</body>
</html>
@helper FormatWorkingHours(double value)
        {
var hour = (int)value;
var hourStr = hour.ToString();
if (hour < 10)
{
    hourStr = "0" + hourStr;
}
hourStr += "h";
var minute = Math.Round(((value - hour) * 60));
var minuteStr = minute.ToString();
if (minute < 10)
{
    minuteStr = "0" + minuteStr;
}
minuteStr += "'";

    <span>@(hourStr + minuteStr)</span>
}

@helper GetGradeRange(string scoreStr, IEnumerable<StandardGradeModel> grades)
{
if (string.IsNullOrEmpty(scoreStr))
{
        <span>@Lang.Dash</span>
}
else
{
    double score = Math.Round(float.Parse(scoreStr));

    foreach (var grade in grades)
    {
        if (score >= grade.LeftScore && score <= grade.RightScore)
        {
                <span>@grade.Code</span>
        }

    }
}

}

@functions{

    private static double GetLastScore(IEnumerable<EPAKPIGroupModel> lastRatings, int groupId, int kpiId)
    {
        var lastScore = lastRatings.Where(i => i.KPIGroupId == groupId).SelectMany(a => a.KPIs.Where(i => i.KPIId == kpiId).Select(k => k.EvaluationByEvaluators.Where(d => d.Score != 0).Select(s => s.Score).DefaultIfEmpty(0).Average()));

        return lastScore.Select(i => Math.Round(i, 2)).SingleOrDefault();
    }

    private static double GetLastWeight(IEnumerable<EPAKPIGroupModel> lastRatings, int groupId, int kpiId)
    {
        var lastWeight = lastRatings.Where(i => i.KPIGroupId == groupId).SelectMany(a => a.KPIs.Where(i => i.KPIId == kpiId).Select(w => w.Weight));

        return lastWeight.Select(i => Math.Round(i, 2)).SingleOrDefault();
    }

    private static double GetSubtotalLastScore(IEnumerable<EPAKPIGroupModel> lastRatings, int groupId)
    {
        var lastScore = lastRatings.Where(i => i.KPIGroupId == groupId).SelectMany(a => a.KPIs).Sum(e => e.EvaluationByEvaluators.Where(d => d.Score != 0).Select(s => s.Score).DefaultIfEmpty(0).Average());

        return Math.Round(lastScore, 2);
    }

    private static double GetSubtotalLastWeight(IEnumerable<EPAKPIGroupModel> lastRatings, int groupId)
    {
        var lastWeight = lastRatings.Where(i => i.KPIGroupId == groupId).Select(w => w.Weight);

        return lastWeight.Select(i => Math.Round(i.Value, 2)).SingleOrDefault();
    }

    private static double FormatScore(double value)
    {
        double step = (double)Math.Pow(10, 2);
        int tmp = (int)Math.Truncate(step * value);

        return tmp / step;
    }
}

@helper  SubtotalLastRating(IEnumerable<EPAKPIGroupModel> lastRatings, int groupId)
{
var score = GetSubtotalLastScore(lastRatings, groupId);
var weight = GetSubtotalLastWeight(lastRatings, groupId);
if (score == 0)
{
        <td class="content-table"> @Lang.Dash</td> ;
    }
    else
    {
        <td class="content-table-left"> @(score + "/" + weight)</td> ;
    }
}

@helper LastRating(IEnumerable<EPAKPIGroupModel> lastRatings, int groupId, int kpiId, int numberEvaluator)
{
var score = GetLastScore(lastRatings, groupId, kpiId);
var weight = GetLastWeight(lastRatings, groupId, kpiId);
if (score == 0)
{
        <td rowspan="@numberEvaluator" class="content-table width-medium">
            @Lang.Dash
        </td>
}
else
{
        <td rowspan="@numberEvaluator" class="content-table-left width-medium">
            @(score + "/" + weight)
        </td>
}
}
