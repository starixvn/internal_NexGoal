@using NexGoal.Resources;
@using NexGoal.Model.Authentication;
@model UserSession
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var index = 1;
}

<nav class="navbar navbar-inverse navbar-fixed-top">
    <div class="container-fluid">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="navbar-brand" href="#">
                <img src="~/Content/Site/images/nex-goal.png" />
            </a>
        </div>
        <div id="navbar" class="navbar-collapse collapse">
            <div class="btn-group pull-right">
                <button type="button" class="btn btn-default">@Model.EmployeeInfo.FullName - @Model.EmployeeInfo.NickName</button>
                <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="caret"></span>
                    <span class="sr-only">Toggle Dropdown</span>
                </button>
                <ul class="dropdown-menu" data-ng-controller="EmployeeProfileController as employeeProfileCtrl">
                    @if (@Model.EmployeeInfo.IsSpecialUser)
                    {
                        <li>
                            <a href="javascript:;" data-ng-click="employeeProfileCtrl.changePassword()">@Lang.ChangePassword</a>
                        </li>
                    }
                    <li>
                        <a href="javascript:;" data-ng-click="employeeProfileCtrl.logout()">@Lang.Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-3 col-md-2 sidebar">
        </div>
        <div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2 main">
        </div>
    </div>
</div>

<div class="row header" id="headerSection">
    <a class="col-xs-12 col-sm-2 logo" href="/">
        <img src="~/Content/Site/Images/sms_epa_logo.png" alt="SMS-EPA" title="SMS-EPA" />
    </a>
    <div class="col-xs-12 col-sm-10">
        <nav id="navbar-example" class="navbar navbar-static top-menu" role="navigation">
            <div class="bs-example-js-navbar-collapse">
                <ul class="nav navbar-nav">
                    @if (@Model.Menus != null)
                    {
                        foreach (var menuParentItem in @Model.Menus)
                        {
                            var childMenuItems = menuParentItem.MenuItems;
                            if (childMenuItems != null && childMenuItems.Count() > 0)
                            {
                                var id = "drop" + index;

                                <li class="dropdown" dropdown>
                                    <a id="@id" href="#" data-role="button" class="dropdown-toggle" dropdown-toggle>
                                        @menuParentItem.MenuName<b class="caret"></b>
                                    </a>
                                    <ul class="dropdown-menu" data-role="button" aria-labelledby="@id">
                                        @foreach (var childMenu in childMenuItems)
                                        {
                                            <li data-role="presentation">
                                                <a data-role="menuitem" tabindex="-1" href="@childMenu.MenuLink">@childMenu.MenuName</a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                                index++;
                            }
                            else
                            {
                                <li>
                                    <a href="@menuParentItem.MenuLink">@menuParentItem.MenuName</a>
                                </li>
                            }
                        }
                    }
                </ul>
            </div>
        </nav>
        <div id="user_utilities" class="user-info info" data-ng-controller="EmployeeProfileController as employeeProfileCtrl">
            <h2>
                @Model.EmployeeInfo.FullName - @Model.EmployeeInfo.NickName
            </h2>
            <a class="dropdown-arrow" href="javascript:;"></a>
            <ol>
                @if (@Model.EmployeeInfo.IsSpecialUser)
                {
                    <li>
                        <a href="javascript:;" data-ng-click="employeeProfileCtrl.changePassword()">@Lang.ChangePassword</a>
                    </li>
                }
                <li><a href="javascript:;" data-ng-click="employeeProfileCtrl.logout()">@Lang.Logout</a> </li>
            </ol>
        </div>
    </div>
</div>
<div class="row">
    <div class="loading-process" style="display: none"></div>
    <div data-ng-view></div>
</div>

