CREATE OR ALTER   PROCEDURE [dbo].[SyncEmployeeCalendar_Import]    
    @CalendarXml NVARCHAR(MAX),
    @ErrCode INT = 0 OUTPUT,
    @ErrMsg nvarchar(200) = '' OUTPUT
AS
/*
EXEC [dbo].[SyncEmployeeCalendar_Import]    
    @CalendarXml ='<ROOT>
    <EmployeeCalendar Id='1' EmpId='1' WorkDate='2024-03-20' IsHoliday='0' IsLeaveDay='0' 
        LeaveDay='0' ModifiedDate='2024-03-20'></EmployeeCalendar>
    </ROOT>'
*/
BEGIN
    SET NOCOUNT ON;

    DECLARE @DocHandler INT

    SELECT @CalendarXml = REPLACE(ISNULL(@CalendarXml,''),'&','&amp;')
    
    IF OBJECT_ID('tempdb..#EmployeeCalendar') IS NOT NULL
    BEGIN
        DROP TABLE #EmployeeCalendar
    END

    CREATE TABLE #EmployeeCalendar (        
        Id BIGINT,
        EmpId INT,
        WorkDate DATETIME,
        IsOffDay BIT,
        IsHoliday BIT,
        IsLeaveDay BIT,
        LeaveDay DECIMAL(18,1),
        ModifiedDate DATETIME
    )
 
    BEGIN TRY
        EXEC sp_xml_preparedocument @DocHandler OUTPUT, @CalendarXml

        INSERT INTO #EmployeeCalendar
        SELECT
            Id,
            EmpId,
            WorkDate,
            IsOffDay,
            IsHoliday,
            IsLeaveDay,
            CASE 
                WHEN ISNUMERIC(LeaveDay) = 1 THEN CAST(LeaveDay AS DECIMAL(18,1))
                ELSE NULL 
            END,
            ModifiedDate
        FROM OPENXML(@DocHandler, '/ROOT/EmployeeCalendar', 1) WITH (
            Id BIGINT,
            EmpId INT,
            WorkDate DATETIME,
            IsOffDay BIT,
            IsHoliday BIT,
            IsLeaveDay BIT,
            LeaveDay NVARCHAR(50),
            ModifiedDate DATETIME
        )

        EXEC sp_xml_removedocument @DocHandler
    END TRY
    BEGIN CATCH
        IF @DocHandler IS NOT NULL
            EXEC sp_xml_removedocument @DocHandler

        SELECT @ErrCode = ERROR_NUMBER()
            ,@ErrMsg = ERROR_MESSAGE()
        RETURN
    END CATCH;
     
    MERGE INTO [dbo].[EmployeeCalendar] AS Target
    USING #EmployeeCalendar AS Source
    ON Target.Id = Source.Id
    WHEN MATCHED THEN
        UPDATE SET
            Target.EmpId = Source.EmpId,
            Target.WorkDate = Source.WorkDate,
            Target.IsOffDay = Source.IsOffDay,
            Target.IsHoliday = Source.IsHoliday,
            Target.IsLeaveDay = Source.IsLeaveDay,
            Target.LeaveDay = Source.LeaveDay,
            Target.ModifiedDate = Source.ModifiedDate,
            Target.SyncDate = GETDATE()
    WHEN NOT MATCHED BY TARGET THEN
        INSERT (
            Id, EmpId, WorkDate, IsOffDay, IsHoliday, IsLeaveDay, 
            LeaveDay, ModifiedDate, SyncDate
        )
        VALUES (
            Source.Id, Source.EmpId, Source.WorkDate, Source.IsOffDay, Source.IsHoliday, Source.IsLeaveDay, 
            Source.LeaveDay, Source.ModifiedDate, GETDATE()
        );

    SELECT @ErrCode = 0, @ErrMsg = '';
      

    DROP TABLE #EmployeeCalendar;
END 

GO

CREATE OR ALTER PROCEDURE [dbo].[SyncEmployeeOvertime_GetLastModifiedDate]
AS
BEGIN
    SET NOCOUNT ON;

    SELECT MAX(ModifiedDate) AS LastModifiedDate
    FROM [dbo].[EmployeeOvertime]
    WHERE ModifiedDate IS NOT NULL;
END 

GO

CREATE OR ALTER   PROCEDURE [dbo].[SyncEmployeeOvertime_Import]    
    @OvertimeXml NVARCHAR(MAX),
    @ErrCode INT = 0 OUTPUT,
    @ErrMsg nvarchar(200) = '' OUTPUT
AS
/*
EXEC [dbo].[SyncEmployeeOvertime_Import]    
    @OvertimeXml ='<ROOT>
    <EmployeeOvertime OvertimeId='1' EmployeeId='1' Date='2024-03-20' 
        Hour='2.5' ModifiedDate='2024-03-20'></EmployeeOvertime>
    </ROOT>'
*/
BEGIN
    SET NOCOUNT ON;

    DECLARE @DocHandler INT

    SELECT @OvertimeXml = REPLACE(ISNULL(@OvertimeXml,''),'&','&amp;')
    
    IF OBJECT_ID('tempdb..#EmployeeOvertime') IS NOT NULL
    BEGIN
        DROP TABLE #EmployeeOvertime
    END

    CREATE TABLE #EmployeeOvertime (        
        OvertimeId INT,
        EmployeeId INT,
        Date DATETIME,
        Hour DECIMAL(18,1),
        ModifiedDate DATETIME
    )
 
    BEGIN TRY
        EXEC sp_xml_preparedocument @DocHandler OUTPUT, @OvertimeXml

        INSERT INTO #EmployeeOvertime
        SELECT
            OvertimeId,
            EmployeeId,
            Date,
            CASE 
                WHEN ISNUMERIC(Hour) = 1 THEN CAST(Hour AS DECIMAL(18,1))
                ELSE NULL 
            END,
            ModifiedDate
        FROM OPENXML(@DocHandler, '/ROOT/EmployeeOvertime', 1) WITH (
            OvertimeId INT,
            EmployeeId INT,
            Date DATETIME,
            Hour NVARCHAR(50),
            ModifiedDate DATETIME
        )

        EXEC sp_xml_removedocument @DocHandler
    END TRY
    BEGIN CATCH
        IF @DocHandler IS NOT NULL
            EXEC sp_xml_removedocument @DocHandler

        SELECT @ErrCode = ERROR_NUMBER()
            ,@ErrMsg = ERROR_MESSAGE()
        RETURN
    END CATCH;
     
    BEGIN TRY
        MERGE INTO [dbo].[EmployeeOvertime] AS Target
        USING #EmployeeOvertime AS Source
        ON Target.OvertimeId = Source.OvertimeId 
            AND Target.EmployeeId = Source.EmployeeId
            AND Target.Date = Source.Date
        WHEN MATCHED THEN
            UPDATE SET
                Target.Hour = Source.Hour,
                Target.ModifiedDate = Source.ModifiedDate,
                Target.SyncDate = GETDATE()
        WHEN NOT MATCHED BY TARGET THEN
            INSERT (
                OvertimeId, EmployeeId, Date, Hour, 
                ModifiedDate, SyncDate
            )
            VALUES (
                Source.OvertimeId, Source.EmployeeId, Source.Date, Source.Hour, 
                Source.ModifiedDate, GETDATE()
            );

        SELECT @ErrCode = 0, @ErrMsg = '';
    END TRY
    BEGIN CATCH
        SELECT @ErrCode = ERROR_NUMBER()
            ,@ErrMsg = ERROR_MESSAGE()
    END CATCH;

    IF OBJECT_ID('tempdb..#EmployeeOvertime') IS NOT NULL
        DROP TABLE #EmployeeOvertime;
END 

GO

CREATE OR ALTER PROCEDURE [dbo].[SyncGroup_GetLastModifiedDate]
AS
BEGIN
	SET NOCOUNT ON;

	SELECT MAX(ModifiedDate) AS LastModifiedDate
	FROM [dbo].[Group]
	WHERE ModifiedDate IS NOT NULL;
END

GO

CREATE OR ALTER   PROCEDURE [dbo].[SyncGroup_Import]	
	@GroupXml NVARCHAR(MAX),
	@ErrCode INT = 0 OUTPUT,
	@ErrMsg nvarchar(200) = '' OUTPUT
AS
/*
EXEC [dbo].[SyncGroup_Import]	
	@GroupXml ='<ROOT>
	<Group GroupId='1' Code='G001' Name='Group 1' DepartmentId='1' Rank='1' IsDeleted='0' ParentId='0' ModifiedDate='2024-03-20'></Group>
	</ROOT>'
*/
BEGIN
	SET NOCOUNT ON;

	-- For write log
	DECLARE 
		@StartRun					DATETIME,
		@EndRun						DATETIME,
		@Duration					INT,
		@LogTraderData				NVARCHAR(MAX),	
		@LogTraderOldData			NVARCHAR(MAX),	
		@Xml						XML		 

	DECLARE @DocHandler INT

	SELECT @GroupXml = REPLACE(ISNULL(@GroupXml,''),'&','&amp;')
	
	IF OBJECT_ID('tempdb..#Group') IS NOT NULL
	BEGIN
		DROP TABLE #Group
	END

	CREATE TABLE #Group (		
		GroupId INT,
		Code VARCHAR(20),
		Name NVARCHAR(50),
		DepartmentId INT,
		Rank INT,
		IsDeleted BIT,
		ParentId INT,
		ModifiedDate DATETIME
	)
 
	BEGIN TRY
		EXEC sp_xml_preparedocument @DocHandler OUTPUT, @GroupXml

		INSERT INTO #Group
		SELECT
			GroupId,
			Code,
			Name,
			DepartmentId,
			Rank,
			IsDeleted,
			ParentId,
			CASE WHEN ISDATE(ModifiedDate) = 1 THEN CAST(ModifiedDate AS DATETIME) ELSE NULL END
		FROM OPENXML(@DocHandler, '/ROOT/Group', 1) WITH (
			GroupId INT,
			Code VARCHAR(20),
			Name NVARCHAR(50),
			DepartmentId INT,
			Rank INT,
			IsDeleted BIT,
			ParentId INT,
			ModifiedDate NVARCHAR(50)
		)

		EXEC sp_xml_removedocument @DocHandler
	END TRY

	BEGIN CATCH
		SELECT @ErrCode = 100
			,@ErrMsg = N'Parameter invalid.'
		RETURN
	END CATCH;
	 
	MERGE INTO [dbo].[Group] AS Target
	USING #Group AS Source
	ON Target.GroupId = Source.GroupId
	WHEN MATCHED THEN
		UPDATE SET
			Target.Code = Source.Code,
			Target.Name = Source.Name,
			Target.DepartmentId = Source.DepartmentId,
			Target.Rank = Source.Rank,
			Target.IsDeleted = Source.IsDeleted,
			Target.ParentId = Source.ParentId,
			Target.ModifiedDate = Source.ModifiedDate,
			Target.SyncDate = GETDATE()
	WHEN NOT MATCHED BY TARGET THEN
		INSERT (
			GroupId, Code, Name, DepartmentId, Rank, IsDeleted, ParentId, ModifiedDate, SyncDate
		)
		VALUES (
			Source.GroupId, Source.Code, Source.Name, Source.DepartmentId, Source.Rank,
			Source.IsDeleted, Source.ParentId, Source.ModifiedDate, GETDATE()
		);

	SELECT @ErrCode = 0, @ErrMsg = '';

	DROP TABLE #Group;
END

GO

