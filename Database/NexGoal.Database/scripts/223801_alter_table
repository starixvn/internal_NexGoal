CREATE TABLE dbo.Employee (
    EmployeeId INT PRIMARY KEY,
    DomainUsername NVARCHAR(255),
    Code NVARCHAR(50),
    FullName NVARCHAR(255),
    NickName NVARCHAR(255),
    GroupId INT,
    Enabled BIT,
    IsDeleted BIT,
    JoinedDate DATE,
    ConfirmedDate DATE,
    JobTitleId INT,
    Email NVARCHAR(255),
    ConversationId NVARCHAR(255),
	ModifiedDate DATETIME NULL,
    SyncDate DATETIME NULL
);

GO

CREATE TABLE [dbo].[Group](
	[GroupId] [int] PRIMARY KEY NOT NULL,
	[Code] [varchar](20) NOT NULL,
	[Name] [nvarchar](50) NOT NULL,
	[DepartmentId] [int] NULL,
	[Rank] [int] NULL,
	[IsDeleted] [bit] NULL,
	[ParentId] [int] NULL,
    [ModifiedDate] [datetime] NULL,
    [SyncDate] [datetime] NULL
);

GO


CREATE TABLE [dbo].[EmployeeAttendance](
	[Id] [bigint]  NOT NULL,
	[EmpId] [int] NOT NULL,
	[AttendanceDate] [datetime] NOT NULL,
	[InFixed] [datetime] NULL,
	[OutFixed] [datetime] NULL,
	[LeaveTypeId] [int] NULL,
	[TotalWorkHours] [decimal](18, 2) NULL,
	[LeaveDay] [decimal](18, 1) NULL,
	[LeaveTypeId2] [int] NULL,
    [InsertDate] [datetime] NULL,
    [SyncDate] [datetime] NULL
 CONSTRAINT [PK_EmployeeAttendance] PRIMARY KEY NONCLUSTERED 
(
	[Id] ASC
)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF) ON [PRIMARY]
) ON [PRIMARY]

GO


CREATE TABLE [dbo].[EmployeeCalendar](
	[Id] [bigint]NOT NULL,
	[EmpId] [int] NOT NULL,
	[WorkDate] [datetime] NOT NULL,
    [IsOffDay] [bit] NULL,
	[IsHoliday] [bit] NULL,
	[IsLeaveDay] [bit] NULL,
	[LeaveDay] [decimal](18, 1) NULL,
	[ModifiedDate] [datetime] NULL,
    [SyncDate] [datetime] NULL
 CONSTRAINT [PK_EmployeeCalendar] PRIMARY KEY NONCLUSTERED 
(
	[Id] ASC
)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF) ON [PRIMARY]
) ON [PRIMARY]
GO



CREATE TABLE [dbo].[EmployeeOvertime](
	[OvertimeId] [int] NOT NULL,
	[EmployeeId] [int] NOT NULL,
	[Date] [datetime] NOT NULL,
	[Hour] [numeric](18, 1) NOT NULL,
	[ModifiedDate] [datetime] NULL,
	[SyncDate] [datetime] NULL
 CONSTRAINT [PK_EmployeeOvertime] PRIMARY KEY CLUSTERED 
(
	[OvertimeId] ASC,
	[EmployeeId] ASC,
	[Date] ASC
)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF) ON [PRIMARY]
) ON [PRIMARY]
GO


