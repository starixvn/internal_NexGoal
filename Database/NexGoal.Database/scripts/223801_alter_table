CREATE OR ALTER PROCEDURE [dbo].[SyncWorkingTimeRequest_GetLastModifiedDate]
AS
BEGIN
    SET NOCOUNT ON;

    SELECT MAX(ModifiedDate) AS LastModifiedDate
    FROM [dbo].[WorkingTimeRequest]
    WHERE ModifiedDate IS NOT NULL;
END 

GO

CREATE OR ALTER   PROCEDURE [dbo].[SyncWorkingTimeRequest_Import]    
    @WorkingTimeRequestXml NVARCHAR(MAX),
    @ErrCode INT = 0 OUTPUT,
    @ErrMsg nvarchar(200) = '' OUTPUT
AS
/*
EXEC [dbo].[SyncWorkingTimeRequest_Import]    
    @WorkingTimeRequestXml ='<ROOT>
    <WorkingTimeRequest Id='1' EmpId='1' RequestType='1' Status='1' 
        FromDate='2024-03-20' ToDate='2024-03-21' TotalDays='1.5' ModifiedDate='2024-03-20'></WorkingTimeRequest>
    </ROOT>'
*/
BEGIN
    SET NOCOUNT ON;

    DECLARE @DocHandler INT

    SELECT @WorkingTimeRequestXml = REPLACE(ISNULL(@WorkingTimeRequestXml,''),'&','&amp;')
    
    IF OBJECT_ID('tempdb..#WorkingTimeRequest') IS NOT NULL
    BEGIN
        DROP TABLE #WorkingTimeRequest
    END

    CREATE TABLE #WorkingTimeRequest (        
        Id BIGINT,
        EmpId INT,
        RequestType SMALLINT,
        Status TINYINT,
        FromDate DATETIME,
        ToDate DATETIME,
        TotalDays NUMERIC(5,1),
        ModifiedDate DATETIME
    )
 
    BEGIN TRY
        EXEC sp_xml_preparedocument @DocHandler OUTPUT, @WorkingTimeRequestXml

        INSERT INTO #WorkingTimeRequest
        SELECT
            Id,
            EmpId,
            RequestType,
            Status,
            CASE WHEN ISDATE(FromDate) = 1 THEN CAST(FromDate AS DATETIME) ELSE NULL END,
            CASE WHEN ISDATE(ToDate) = 1 THEN CAST(ToDate AS DATETIME) ELSE NULL END,
            CASE WHEN ISNUMERIC(TotalDays) = 1 THEN CAST(TotalDays AS DECIMAL(18,1)) ELSE NULL END,
            ModifiedDate
        FROM OPENXML(@DocHandler, '/ROOT/WorkingTimeRequest', 1) WITH (
            Id BIGINT,
            EmpId INT,
            RequestType SMALLINT,
            Status TINYINT,
            FromDate NVARCHAR(50),
            ToDate NVARCHAR(50),
            TotalDays NVARCHAR(50),
            ModifiedDate DATETIME
        )

        EXEC sp_xml_removedocument @DocHandler
    END TRY
    BEGIN CATCH
        IF @DocHandler IS NOT NULL
            EXEC sp_xml_removedocument @DocHandler

        SELECT @ErrCode = ERROR_NUMBER()
            ,@ErrMsg = ERROR_MESSAGE()
        RETURN
    END CATCH;
     
    BEGIN TRY
        MERGE INTO [dbo].[WorkingTimeRequest] AS Target
        USING #WorkingTimeRequest AS Source
        ON Target.Id = Source.Id
        WHEN MATCHED THEN
            UPDATE SET
                Target.EmpId = Source.EmpId,
                Target.RequestType = Source.RequestType,
                Target.Status = Source.Status,
                Target.FromDate = Source.FromDate,
                Target.ToDate = Source.ToDate,
                Target.TotalDays = Source.TotalDays,
                Target.ModifiedDate = Source.ModifiedDate,
                Target.SyncDate = GETDATE()
        WHEN NOT MATCHED BY TARGET THEN
            INSERT (
                Id, EmpId, RequestType, Status, FromDate, ToDate, TotalDays, ModifiedDate, SyncDate
            )
            VALUES (
                Source.Id, Source.EmpId, Source.RequestType, Source.Status, 
                Source.FromDate, Source.ToDate, Source.TotalDays, Source.ModifiedDate, GETDATE()
            );

        SELECT @ErrCode = 0, @ErrMsg = '';
    END TRY
    BEGIN CATCH
        SELECT @ErrCode = ERROR_NUMBER()
            ,@ErrMsg = ERROR_MESSAGE()
    END CATCH;

    IF OBJECT_ID('tempdb..#WorkingTimeRequest') IS NOT NULL
        DROP TABLE #WorkingTimeRequest;
END
GO

CREATE OR ALTER PROCEDURE [dbo].[PerformanceRecord_GetByEmployee] @EmployeeId INT
AS
/*
Created: 20180912@Tim.Trinh
Task: Get PCI by employee.
DB: bodb_NexGoal
Original:

Revisions:
	20191118@elton.ton: get more information for system pa
	20200217@drake.doi: Get PR's feedback, reaction
Param's Explanation:

*/
BEGIN
	SET NOCOUNT ON;

	DECLARE @Today DATE = GETDATE()
		,@PAClosed TINYINT = 4
	-- Performance Record Type
	DECLARE @Checkin TINYINT = 1
		,@SystemPA TINYINT = 4
		,@SystemNomination TINYINT = 5

	CREATE TABLE #tblPerformanceRecord (
		PerformanceRecordId INT
		,GradeId VARCHAR(MAX)
		,Comment NVARCHAR(MAX)
		,IsDraft BIT
		,ProjectIds VARCHAR(MAX)
		,CreatedDate DATETIME
		,ModifiedDate DATETIME
		,RoleId TINYINT
		,TypeId TINYINT
		,EmployeeId INT
		,CreatorId INT
		,NominationPeriodId INT
		,NominationStatusId TINYINT
		,[Quarter] TINYINT
		,[Year] INT
		,PeriodId INT
		,PeriodName NVARCHAR(300)
		)

	INSERT INTO #tblPerformanceRecord (
		PerformanceRecordId
		,GradeId
		,Comment
		,IsDraft
		,ProjectIds
		,CreatedDate
		,ModifiedDate
		,RoleId
		,TypeId
		,EmployeeId
		,CreatorId
		,NominationPeriodId
		,NominationStatusId
		,[Quarter]
		,[Year]
		,PeriodId
		,PeriodName
		)
	-- draft performance record
	SELECT record.DraftPerformanceRecordId AS PerformanceRecordId
		,record.GradeId
		,record.Comment
		,1 AS IsDraft
		,record.ProjectIds
		,record.CreatedDate
		,record.ModifiedDate
		,record.RoleId
		,record.TypeId
		,emp.EmployeeId
		,record.CreatorId
		,NULL AS NominationPeriodId
		,NULL AS NominationStatusId
		,NULL AS [Quarter]
		,NULL AS [Year]
		,NULL AS PeriodId
		,NULL AS PeriodName
	FROM dbo.DraftPerformanceRecord AS record WITH (NOLOCK)
		INNER JOIN dbo.Employee AS emp WITH (NOLOCK) ON (CASE 
			WHEN record.EmployeeIds NOT LIKE '%[^0-9]%' THEN CAST(record.EmployeeIds AS INT)
			ELSE - 1 END
			) = emp.EmployeeId
		AND emp.EmployeeId = @EmployeeId
		LEFT JOIN dbo.Employee AS creator WITH (NOLOCK) ON record.CreatorId = creator.EmployeeId
	WHERE record.CreatorId = @EmployeeId
	
	UNION
	-- performance record
	SELECT record.PerformanceRecordId
		,record.GradeId
		,record.Comment
		,0 AS IsDraft
		,record.ProjectIds
		,record.CreatedDate
		,record.ModifiedDate
		,record.RoleId
		,record.TypeId
		,record.EmployeeId
		,record.CreatorId
		,NULL AS NominationPeriodId
		,NULL AS NominationStatusId
		,NULL AS [Quarter]
		,NULL AS [Year]
		,NULL AS PeriodId
		,NULL AS PeriodName
	FROM dbo.PerformanceRecord AS record WITH (NOLOCK)
		INNER JOIN dbo.Employee AS emp WITH (NOLOCK) ON record.EmployeeId = emp.EmployeeId
		AND emp.EmployeeId = @EmployeeId
		LEFT JOIN dbo.Employee AS creator WITH (NOLOCK) ON record.CreatorId = creator.EmployeeId
	WHERE record.TypeId = @Checkin
	
	UNION
	-- system PA
	SELECT record.PerformanceRecordId
		,record.GradeId
		,record.Comment
		,0 AS IsDraft
		,record.ProjectIds
		,record.CreatedDate
		,record.ModifiedDate
		,record.RoleId
		,record.TypeId
		,record.EmployeeId
		,record.CreatorId
		,NULL AS NominationPeriodId
		,NULL AS NominationStatusId
		,NULL AS [Quarter]
		,NULL AS [Year]
		,p.PeriodId AS PeriodId
		,p.[Name] AS PeriodName
	FROM dbo.PerformanceRecord AS record WITH (NOLOCK)
		INNER JOIN dbo.Employee AS emp WITH (NOLOCK) ON record.EmployeeId = emp.EmployeeId
		AND emp.EmployeeId = @EmployeeId
		INNER JOIN dbo.PARecord AS pa WITH (NOLOCK) ON record.PerformanceRecordId = pa.PerformanceRecordId
		AND pa.StatusId = @PAClosed
		AND emp.EmployeeId = pa.EmployeeId
		INNER JOIN dbo.Period AS p WITH (NOLOCK) ON pa.PeriodId = p.PeriodId
		AND p.IsActive = 1
		LEFT JOIN dbo.Employee AS creator WITH (NOLOCK) ON record.CreatorId = creator.EmployeeId
	WHERE record.TypeId = @SystemPA
	
	UNION
	-- nomination result
	SELECT record.PerformanceRecordId
		,record.GradeId
		,record.Comment
		,0 AS IsDraft
		,record.ProjectIds
		,record.CreatedDate
		,record.ModifiedDate
		,record.RoleId
		,record.TypeId
		,record.EmployeeId
		,record.CreatorId
		,nomination.EOQYId AS NominationPeriodId
		,nomination.StatusId AS NominationStatusId
		,period.[Quarter]
		,period.[Year]
		,NULL AS PeriodId
		,NULL AS PeriodName
	FROM dbo.PerformanceRecord AS record WITH (NOLOCK)
		INNER JOIN dbo.Employee AS emp WITH (NOLOCK) ON record.EmployeeId = emp.EmployeeId
		AND emp.EmployeeId = @EmployeeId
		LEFT JOIN dbo.Nomination AS nomination WITH (NOLOCK) ON record.PerformanceRecordId = nomination.PerformanceRecordId
		LEFT JOIN dbo.EOQY AS period WITH (NOLOCK) ON nomination.EOQYId = period.EOQYId
		AND period.EndDateForCommittee IS NOT NULL
		AND period.EndDateForCommittee < @Today
	WHERE record.TypeId = @SystemNomination
		AND nomination.NominationId IS NOT NULL
		AND period.EOQYId IS NOT NULL

	SELECT PerformanceRecordId
		,GradeId
		,Comment
		,IsDraft
		,CreatedDate
		,record.ModifiedDate
		,RoleId
		,TypeId
		,NominationStatusId
		,e.EmployeeId
		,e.Code
		,e.NickName
		,e.FullName
		,record.CreatorId AS EmployeeId
		,cre.Code
		,cre.NickName
		,cre.FullName
		,NominationPeriodId
		,[Quarter]
		,[Year]
		,PeriodId
		,PeriodName AS [Name]
	FROM #tblPerformanceRecord AS record
		LEFT JOIN dbo.Employee AS e WITH (NOLOCK) ON record.EmployeeId = e.EmployeeId
		LEFT JOIN dbo.Employee AS cre WITH (NOLOCK) ON record.CreatorId = cre.EmployeeId
	ORDER BY CASE 
			WHEN IsDraft = 1 THEN 1
			ELSE 2
			END
		,CreatedDate DESC

	SELECT record.PerformanceRecordId
		,prj.ProjectId
		,prj.[Name]
	FROM #tblPerformanceRecord AS record
		OUTER APPLY [dbo].[func_SplitString](record.ProjectIds, ',') a
		INNER JOIN dbo.ProjectTag AS prj WITH (NOLOCK) ON a.val = prj.ProjectId

	SELECT pa.PARecordId
		,pa.PerformanceRecordId
		,pa.OriginalGradeId
		,pa.Toeic
		,pa.ToeicPolicy
	FROM dbo.PARecord AS pa WITH (NOLOCK)
		INNER JOIN dbo.Period AS p WITH (NOLOCK) ON pa.PeriodId = p.PeriodId
		AND p.IsActive = 1
	WHERE pa.StatusId = @PAClosed
		AND pa.PerformanceRecordId IS NOT NULL

	SELECT pa.PARecordId
		,pap.ProcessId
		,rr.Value AS Process
		,pap.GradeId
		,pap.RelatedPerformanceRecordIds
	FROM dbo.PARecord AS pa WITH (NOLOCK)
		INNER JOIN dbo.Period AS p WITH (NOLOCK) ON pa.PeriodId = p.PeriodId
		AND p.IsActive = 1
		INNER JOIN dbo.PAProcess AS pap WITH (NOLOCK) ON pa.PARecordId = pap.PARecordId
		INNER JOIN dbo.RefResource AS rr WITH (NOLOCK) ON pap.ProcessId = rr.ResourceId
		AND rr.RefName = 'PerformanceProcess'
	WHERE pa.StatusId = @PAClosed
		AND pa.PerformanceRecordId IS NOT NULL
		AND pap.ProcessId > 1

	SELECT reaction.PRReactionId
		,reaction.PerformanceRecordId
		,reaction.RoleId
		,reaction.CreatedDate
		,creator.EmployeeId
		,creator.Code
		,creator.FullName
		,creator.NickName
	FROM dbo.PRReaction AS reaction WITH (NOLOCK)
		INNER JOIN dbo.Employee AS creator WITH (NOLOCK) ON creator.EmployeeId = reaction.CreatorId
		INNER JOIN #tblPerformanceRecord AS record ON record.IsDraft = 0
		AND reaction.PerformanceRecordId = record.PerformanceRecordId
	ORDER BY reaction.CreatedDate ASC

	SELECT feedback.PRFeedbackId
		,feedback.PerformanceRecordId
		,feedback.Content
		,feedback.RoleId
		,feedback.CreatedDate
		,feedback.ModifiedDate
		,creator.EmployeeId
		,creator.Code
		,creator.FullName
		,creator.NickName
	FROM dbo.PRFeedback AS feedback WITH (NOLOCK)
		INNER JOIN dbo.Employee AS creator WITH (NOLOCK) ON creator.EmployeeId = feedback.CreatorId
		INNER JOIN #tblPerformanceRecord AS record ON record.IsDraft = 0
		AND feedback.PerformanceRecordId = record.PerformanceRecordId
	ORDER BY feedback.CreatedDate ASC

	SELECT reaction.PRFeedbackReactionId
		,reaction.PRFeedbackId
		,reaction.CreatorId
		,reaction.RoleId
		,reaction.CreatedDate
		,creator.EmployeeId
		,creator.Code
		,creator.FullName
		,creator.NickName
	FROM dbo.PRFeedbackReaction AS reaction WITH (NOLOCK)
		INNER JOIN dbo.Employee AS creator WITH (NOLOCK) ON creator.EmployeeId = reaction.CreatorId
		INNER JOIN PRFeedback AS feedback WITH (NOLOCK) ON feedback.PRFeedbackId = reaction.PRFeedbackId
		INNER JOIN #tblPerformanceRecord AS record ON record.IsDraft = 0
		AND feedback.PerformanceRecordId = record.PerformanceRecordId
	ORDER BY reaction.CreatedDate ASC

	DROP TABLE #tblPerformanceRecord
END

GO


CREATE OR ALTER PROCEDURE [dbo].[PerformanceRecord_GetById] @PerformanceRecordId INT
	,@CreatorId INT
AS
/*
Created: 20180912@Tim.Trinh
Task: Get PCI by id.
DB: bodb_NexGoal
Original:

Revisions:
Param's Explanation:

*/
BEGIN
	SET NOCOUNT ON;

	SELECT PerformanceRecordId
		,GradeId
		,Comment
		,0 AS IsDraft
		,CreatedDate
		,record.ModifiedDate
		,RoleId
		,TypeId
		,e.EmployeeId
		,e.Code
		,e.NickName
		,e.FullName
		,cre.EmployeeId
		,cre.Code
		,cre.NickName
		,cre.FullName
	FROM dbo.PerformanceRecord AS record WITH (NOLOCK)
		LEFT JOIN dbo.Employee AS e WITH (NOLOCK) ON record.EmployeeId = e.EmployeeId
		LEFT JOIN dbo.Employee AS cre WITH (NOLOCK) ON record.CreatorId = cre.EmployeeId
	WHERE record.PerformanceRecordId = @PerformanceRecordId
		AND record.CreatorId = @CreatorId
		AND record.TypeId = 1

	SELECT record.PerformanceRecordId
		,prj.ProjectId
		,prj.[Name]
	FROM dbo.PerformanceRecord AS record WITH (NOLOCK)
		OUTER APPLY [dbo].[func_SplitString](record.ProjectIds, ',') a
		INNER JOIN dbo.ProjectTag AS prj WITH (NOLOCK) ON a.val = prj.ProjectId
	WHERE record.PerformanceRecordId = @PerformanceRecordId
		AND record.CreatorId = @CreatorId
		AND record.TypeId = 1
END

GO


CREATE OR ALTER PROCEDURE [dbo].[PerformanceRecord_GetByIds] @PerformanceRecordIds VARCHAR(MAX)
	,@CreatorId INT
AS
/*
Created: 20181127@Tim.Trinh
Task: Get PCI by ids.
DB: bodb_NexGoal
Original:

Revisions:
Param's Explanation:

*/
BEGIN
	SET NOCOUNT ON;

	CREATE TABLE #tblPerformanceRecordIds (PerformanceRecordId INT)

	INSERT INTO #tblPerformanceRecordIds (PerformanceRecordId)
	SELECT val
	FROM dbo.func_SplitString(@PerformanceRecordIds, ',')
	WHERE ISNUMERIC(val) = 1

	SELECT record.PerformanceRecordId
		,GradeId
		,Comment
		,0 AS IsDraft
		,CreatedDate
		,record.ModifiedDate
		,RoleId
		,TypeId
		,e.EmployeeId
		,e.Code
		,e.NickName
		,e.FullName
		,cre.EmployeeId
		,cre.Code
		,cre.NickName
		,cre.FullName
	FROM #tblPerformanceRecordIds AS per
		INNER JOIN dbo.PerformanceRecord AS record WITH (NOLOCK) ON per.PerformanceRecordId = record.PerformanceRecordId
		LEFT JOIN dbo.Employee AS e WITH (NOLOCK) ON record.EmployeeId = e.EmployeeId
		LEFT JOIN dbo.Employee AS cre WITH (NOLOCK) ON record.CreatorId = cre.EmployeeId
	ORDER BY CreatedDate DESC

	SELECT record.PerformanceRecordId
		,prj.ProjectId
		,prj.[Name]
	FROM #tblPerformanceRecordIds AS per
		INNER JOIN dbo.PerformanceRecord AS record WITH (NOLOCK) ON per.PerformanceRecordId = record.PerformanceRecordId
		OUTER APPLY [dbo].[func_SplitString](record.ProjectIds, ',') a
		INNER JOIN dbo.ProjectTag AS prj WITH (NOLOCK) ON a.val = prj.ProjectId

	DROP TABLE #tblPerformanceRecordIds
END
GO

CREATE OR ALTER PROCEDURE [dbo].[PerformanceRecord_GetMemberPerformance] @ActorId INT
AS
/*
Created: 20181026@Tim.Trinh
Task: Get member PCI.
DB: bodb_NexGoal
Original:

Revisions:
- 20200217@drake.doi: Get PR's feedback, reaction
Param's Explanation:

*/
BEGIN
	SET NOCOUNT ON;

	DECLARE @PMProcessId TINYINT = 3
		,@EvaluatorProcessId TINYINT = 4
		,@ReviewerProcessId TINYINT = 5
		,@Checkin TINYINT = 1

	CREATE TABLE #tblMember (
		EmployeeId INT
		,IsHost BIT
		)

	CREATE TABLE #tblPerformanceRecord (
		PerformanceRecordId INT
		,GradeId VARCHAR(MAX)
		,Comment NVARCHAR(MAX)
		,IsDraft BIT
		,ProjectIds VARCHAR(MAX)
		,CreatedDate DATETIME
		,ModifiedDate DATETIME
		,RoleId TINYINT
		,EmployeeIds VARCHAR(MAX)
		,CreatorId INT
		,TypeId TINYINT
		)

	INSERT INTO #tblMember (
		EmployeeId
		,IsHost
		)
	SELECT data.EmployeeId
		,MAX(data.IsHost)
	FROM (
		SELECT EmployeeId
			,(CASE 
				WHEN ProcessId IN (@EvaluatorProcessId, @ReviewerProcessId) THEN 1
				ELSE 0 END
				) AS IsHost
		FROM dbo.func_GetMember(@ActorId)
		WHERE ProcessId IN (@PMProcessId, @EvaluatorProcessId, @ReviewerProcessId)
		) AS data
	GROUP BY data.EmployeeId

	INSERT INTO #tblPerformanceRecord (
		PerformanceRecordId
		,GradeId
		,Comment
		,IsDraft
		,ProjectIds
		,CreatedDate
		,ModifiedDate
		,RoleId
		,EmployeeIds
		,CreatorId
		,TypeId
		)
	SELECT record.DraftPerformanceRecordId AS PerformanceRecordId
		,record.GradeId
		,record.Comment
		,1 AS IsDraft
		,record.ProjectIds
		,record.CreatedDate
		,record.ModifiedDate
		,record.RoleId
		,record.EmployeeIds
		,record.CreatorId
		,record.TypeId
	FROM dbo.DraftPerformanceRecord AS record WITH (NOLOCK)
	WHERE record.EmployeeIds <> CAST(record.CreatorId AS VARCHAR(20))
		AND record.CreatorId = @ActorId
	
	UNION
	SELECT record.PerformanceRecordId
		,record.GradeId
		,record.Comment
		,0 AS IsDraft
		,record.ProjectIds
		,record.CreatedDate
		,record.ModifiedDate
		,record.RoleId
		,CAST(record.EmployeeId AS VARCHAR(20))
		,record.CreatorId
		,record.TypeId
	FROM dbo.PerformanceRecord AS record WITH (NOLOCK)
		INNER JOIN dbo.Employee AS emp WITH (NOLOCK) ON record.EmployeeId = emp.EmployeeId
		AND emp.[Enabled] = 1
		AND emp.IsDeleted = 0
		INNER JOIN dbo.Employee AS creator WITH (NOLOCK) ON record.CreatorId = creator.EmployeeId
		INNER JOIN #tblMember AS member WITH (NOLOCK) ON emp.EmployeeId = member.EmployeeId
	WHERE record.TypeId = @Checkin
		AND (
			member.IsHost = 1
			OR (
				member.IsHost = 0
				AND (
					record.CreatorId = member.EmployeeId
					OR record.CreatorId = @ActorId
					)
				)
			)

	SELECT PerformanceRecordId
		,GradeId
		,Comment
		,IsDraft
		,CreatedDate
		,record.ModifiedDate
		,RoleId
		,TypeId
		,record.CreatorId AS EmployeeId
		,cre.Code
		,cre.NickName
		,cre.FullName
	FROM #tblPerformanceRecord AS record
		LEFT JOIN dbo.Employee AS cre WITH (NOLOCK) ON record.CreatorId = cre.EmployeeId
	ORDER BY CASE 
			WHEN IsDraft = 1 THEN 1
			ELSE 2
			END
		,CreatedDate DESC

	SELECT record.PerformanceRecordId AS LinkObjectId
		,e.EmployeeId
		,e.Code
		,e.NickName
		,e.FullName
	FROM #tblPerformanceRecord AS record
		OUTER APPLY [dbo].[func_SplitString](record.EmployeeIds, ',') a
		INNER JOIN dbo.Employee AS e WITH (NOLOCK) ON a.val = e.EmployeeId

	SELECT record.PerformanceRecordId
		,prj.ProjectId
		,prj.[Name]
	FROM #tblPerformanceRecord AS record
		OUTER APPLY [dbo].[func_SplitString](record.ProjectIds, ',') a
		INNER JOIN dbo.ProjectTag AS prj WITH (NOLOCK) ON a.val = prj.ProjectId

	SELECT reaction.PRReactionId,
		reaction.PerformanceRecordId,
		reaction.RoleId,
		reaction.CreatedDate,
		creator.EmployeeId,
		creator.Code,
		creator.FullName,
		creator.NickName
	FROM PRReaction AS reaction WITH (NOLOCK)
		INNER JOIN dbo.Employee AS creator WITH (NOLOCK) ON creator.EmployeeId = reaction.CreatorId
		INNER JOIN #tblPerformanceRecord AS record ON record.IsDraft = 0 AND reaction.PerformanceRecordId = record.PerformanceRecordId 
		INNER JOIN #tblMember AS mem ON mem.EmployeeId = CAST(record.EmployeeIds AS VARCHAR(20))
	WHERE reaction.CreatorId = @ActorId
		OR mem.IsHost = 1
		OR record.CreatorId = @ActorId
	ORDER BY reaction.CreatedDate ASC

	SELECT feedback.PRFeedbackId,
		feedback.PerformanceRecordId,
		feedback.Content,
		feedback.RoleId,
		feedback.CreatedDate,
		feedback.ModifiedDate,
		creator.EmployeeId,
		creator.Code,
		creator.FullName,
		creator.NickName
	FROM PRFeedback AS feedback WITH (NOLOCK)
		INNER JOIN dbo.Employee AS creator WITH (NOLOCK) ON creator.EmployeeId = feedback.CreatorId
		INNER JOIN #tblPerformanceRecord AS record ON record.IsDraft = 0 AND feedback.PerformanceRecordId = record.PerformanceRecordId  
		INNER JOIN #tblMember AS mem ON mem.EmployeeId = CAST(record.EmployeeIds AS VARCHAR(20))
	WHERE feedback.CreatorId = @ActorId
		OR mem.IsHost = 1
	ORDER BY feedback.CreatedDate ASC

	SELECT reaction.PRFeedbackReactionId,
		reaction.PRFeedbackId,
		reaction.CreatorId,
		reaction.RoleId,
		reaction.CreatedDate,
		creator.EmployeeId,
		creator.Code,
		creator.FullName,
		creator.NickName
	FROM PRFeedbackReaction AS reaction WITH (NOLOCK)
		INNER JOIN dbo.Employee AS creator WITH (NOLOCK) ON creator.EmployeeId = reaction.CreatorId
		INNER JOIN PRFeedback AS feedback WITH (NOLOCK) ON feedback.PRFeedbackId = reaction.PRFeedbackId
		INNER JOIN #tblPerformanceRecord AS record ON record.IsDraft = 0 AND feedback.PerformanceRecordId = record.PerformanceRecordId 
		INNER JOIN #tblMember AS mem ON mem.EmployeeId = CAST(record.EmployeeIds AS VARCHAR(20))
	WHERE reaction.CreatorId = @ActorId
		OR feedback.CreatorId = @ActorId
		OR mem.IsHost = 1
	ORDER BY reaction.CreatedDate ASC

	DROP TABLE #tblMember

	DROP TABLE #tblPerformanceRecord
END

GO

CREATE OR ALTER PROCEDURE [dbo].[PerformanceRecord_GetMemberPerformanceByMemberId] @ActorId INT
	,@EmployeeId INT
AS
/*
Created: 20181026@Tim.Trinh
Task: Get PCI for a member.
DB: bodb_NexGoal
Original:

Revisions:
	20191118@elton.ton: get more information for system pa
	20200217@drake.doi: Get PR's feedback, reaction
Param's Explanation:

*/
BEGIN
	SET NOCOUNT ON;

	DECLARE @Today DATE = GETDATE()
		,@EmployeeIdString VARCHAR(20)
		,@PAClosed TINYINT = 4
	-- process
	DECLARE @PMProcessId TINYINT = 3
		,@EvaluatorProcessId TINYINT = 4
		,@ReviewerProcessId TINYINT = 5
	-- Performance Record Type
	DECLARE @Checkin TINYINT = 1
		,@SystemPA TINYINT = 4
		,@SystemNomination TINYINT = 5
		,@IsHost BIT = 0

	SET @EmployeeIdString = CAST(@EmployeeId AS VARCHAR(20))

	CREATE TABLE #tblPerformanceRecord (
		PerformanceRecordId INT
		,GradeId VARCHAR(MAX)
		,Comment NVARCHAR(MAX)
		,IsDraft BIT
		,ProjectIds VARCHAR(MAX)
		,CreatedDate DATETIME
		,ModifiedDate DATETIME
		,RoleId TINYINT
		,EmployeeIds VARCHAR(MAX)
		,CreatorId INT
		,NominationStatusId TINYINT
		,TypeId TINYINT
		,NominationPeriodId INT
		,[Quarter] TINYINT
		,[Year] INT
		,PeriodId INT
		,PeriodName NVARCHAR(300)
		)

	SELECT @IsHost = MAX(data.IsHost)
	FROM (
		SELECT EmployeeId
			,(CASE 
				WHEN ProcessId IN (@EvaluatorProcessId, @ReviewerProcessId) THEN 1
				ELSE 0 END
				) AS IsHost
		FROM dbo.func_GetMember(@ActorId)
		WHERE EmployeeId = @EmployeeId
			AND ProcessId IN (@PMProcessId, @EvaluatorProcessId, @ReviewerProcessId)
		) AS data
	GROUP BY data.EmployeeId

	INSERT INTO #tblPerformanceRecord (
		PerformanceRecordId
		,GradeId
		,Comment
		,IsDraft
		,ProjectIds
		,CreatedDate
		,ModifiedDate
		,RoleId
		,EmployeeIds
		,CreatorId
		,TypeId
		,NominationStatusId
		,NominationPeriodId
		,[Quarter]
		,[Year]
		,PeriodId
		,PeriodName
		)
	SELECT data.PerformanceRecordId
		,data.GradeId
		,data.Comment
		,data.IsDraft
		,data.ProjectIds
		,data.CreatedDate
		,data.ModifiedDate
		,data.RoleId
		,data.EmployeeIds
		,data.CreatorId
		,data.TypeId
		,data.NominationStatusId
		,data.NominationPeriodId
		,data.[Quarter]
		,data.[Year]
		,data.PeriodId
		,data.PeriodName
	FROM (
		SELECT record.DraftPerformanceRecordId AS PerformanceRecordId
			,record.GradeId
			,record.Comment
			,1 AS IsDraft
			,record.ProjectIds
			,record.CreatedDate
			,record.ModifiedDate
			,record.RoleId
			,record.EmployeeIds
			,record.CreatorId
			,record.TypeId
			,NULL AS NominationStatusId
			,NULL AS NominationPeriodId
			,NULL AS [Quarter]
			,NULL AS [Year]
			,NULL AS PeriodId
			,NULL AS PeriodName
		FROM dbo.DraftPerformanceRecord AS record WITH (NOLOCK)
		WHERE record.EmployeeIds <> CAST(record.CreatorId AS VARCHAR(20))
			AND record.CreatorId = @ActorId
			AND (
				@EmployeeIdString = ''
				OR record.EmployeeIds LIKE @EmployeeIdString
				OR record.EmployeeIds LIKE @EmployeeIdString + ',%'
				OR record.EmployeeIds LIKE '%,' + @EmployeeIdString + ',%'
				OR record.EmployeeIds LIKE '%,' + @EmployeeIdString
				)
		
		UNION
		SELECT record.PerformanceRecordId
			,record.GradeId
			,record.Comment
			,0 AS IsDraft
			,record.ProjectIds
			,record.CreatedDate
			,record.ModifiedDate
			,record.RoleId
			,CAST(record.EmployeeId AS VARCHAR(20))
			,record.CreatorId
			,record.TypeId
			,NULL AS NominationStatusId
			,NULL AS NominationPeriodId
			,NULL AS [Quarter]
			,NULL AS [Year]
			,p.PeriodId
			,p.[Name] AS PeriodName
		FROM dbo.PerformanceRecord AS record WITH (NOLOCK)
			INNER JOIN dbo.Employee AS emp WITH (NOLOCK) ON record.EmployeeId = emp.EmployeeId
			AND emp.[Enabled] = 1
			AND emp.IsDeleted = 0
			LEFT JOIN dbo.Employee AS creator WITH (NOLOCK) ON record.CreatorId = creator.EmployeeId
			LEFT JOIN dbo.PARecord AS pa WITH (NOLOCK) ON record.PerformanceRecordId = pa.PerformanceRecordId
			AND emp.EmployeeId = pa.EmployeeId
			AND pa.StatusId = @PAClosed
			LEFT JOIN dbo.Period AS p WITH (NOLOCK) ON pa.PeriodId = p.PeriodId
			AND p.IsActive = 1
		WHERE record.EmployeeId = @EmployeeId
			AND (
				record.TypeId = @Checkin
				OR (
					record.TypeId = @SystemPA
					AND pa.PerformanceRecordId IS NOT NULL
					AND p.PeriodId IS NOT NULL
					)
				)
			AND (
				@IsHost = 1
				OR (
					@IsHost = 0
					AND (
						record.CreatorId = @EmployeeId
						OR record.CreatorId = @ActorId
						)
					)
				)
		
		UNION
		SELECT record.PerformanceRecordId
			,record.GradeId
			,record.Comment
			,0 AS IsDraft
			,record.ProjectIds
			,record.CreatedDate
			,record.ModifiedDate
			,record.RoleId
			,CAST(record.EmployeeId AS VARCHAR(20))
			,record.CreatorId
			,record.TypeId
			,nomination.StatusId AS NominationStatusId
			,nomination.EOQYId AS NominationPeriodId
			,period.[Quarter]
			,period.[Year]
			,NULL AS PeriodId
			,NULL AS PeriodName
		FROM dbo.PerformanceRecord AS record WITH (NOLOCK)
			INNER JOIN dbo.Employee AS emp WITH (NOLOCK) ON record.EmployeeId = emp.EmployeeId
			INNER JOIN dbo.Nomination AS nomination WITH (NOLOCK) ON emp.EmployeeId = nomination.NomineeId
			AND record.PerformanceRecordId = nomination.PerformanceRecordId
			INNER JOIN dbo.EOQY AS period WITH (NOLOCK) ON nomination.EOQYId = period.EOQYId
			AND period.EndDateForCommittee < @Today
		WHERE emp.EmployeeId = @EmployeeId
			AND record.TypeId = @SystemNomination
			AND record.CreatorId = - 1
		) AS data

	SELECT PerformanceRecordId
		,GradeId
		,Comment
		,IsDraft
		,CreatedDate
		,record.ModifiedDate
		,RoleId
		,TypeId
		,NominationStatusId
		,record.CreatorId AS EmployeeId
		,cre.Code
		,cre.NickName
		,cre.FullName
		,NominationPeriodId
		,[Quarter]
		,[Year]
		,PeriodId
		,PeriodName AS [Name]
	FROM #tblPerformanceRecord AS record
		LEFT JOIN dbo.Employee AS cre WITH (NOLOCK) ON record.CreatorId = cre.EmployeeId
	ORDER BY CASE 
			WHEN IsDraft = 1 THEN 1
			ELSE 2
			END
		,CreatedDate DESC

	SELECT record.PerformanceRecordId AS LinkObjectId
		,e.EmployeeId
		,e.Code
		,e.NickName
		,e.FullName
	FROM #tblPerformanceRecord AS record
		OUTER APPLY [dbo].[func_SplitString](record.EmployeeIds, ',') a
		INNER JOIN dbo.Employee AS e WITH (NOLOCK) ON a.val = e.EmployeeId

	SELECT record.PerformanceRecordId
		,prj.ProjectId
		,prj.[Name]
	FROM #tblPerformanceRecord AS record
		OUTER APPLY [dbo].[func_SplitString](record.ProjectIds, ',') a
		INNER JOIN dbo.ProjectTag AS prj WITH (NOLOCK) ON a.val = prj.ProjectId

	SELECT pa.PARecordId
		,pa.PerformanceRecordId
		,pa.OriginalGradeId
		,pa.Toeic
		,pa.ToeicPolicy
	FROM dbo.PARecord AS pa WITH (NOLOCK)
		INNER JOIN dbo.Period AS p WITH (NOLOCK) ON pa.PeriodId = p.PeriodId
		AND p.IsActive = 1
	WHERE pa.StatusId = @PAClosed
		AND pa.PerformanceRecordId IS NOT NULL

	SELECT pa.PARecordId
		,pap.ProcessId
		,rr.Value AS Process
		,pap.GradeId
		,pap.RelatedPerformanceRecordIds
	FROM dbo.PARecord AS pa WITH (NOLOCK)
		INNER JOIN dbo.Period AS p WITH (NOLOCK) ON pa.PeriodId = p.PeriodId
		AND p.IsActive = 1
		INNER JOIN dbo.PAProcess pap WITH (NOLOCK) ON pa.PARecordId = pap.PARecordId
		INNER JOIN dbo.RefResource rr WITH (NOLOCK) ON pap.ProcessId = rr.ResourceId
		AND rr.RefName = 'PerformanceProcess'
	WHERE pa.StatusId = @PAClosed
		AND pa.PerformanceRecordId IS NOT NULL
		AND pap.ProcessId > 1

	SELECT reaction.PRReactionId
		,reaction.PerformanceRecordId
		,reaction.RoleId
		,reaction.CreatedDate
		,creator.EmployeeId
		,creator.Code
		,creator.FullName
		,creator.NickName
	FROM dbo.PRReaction AS reaction WITH (NOLOCK)
		INNER JOIN dbo.Employee AS creator WITH (NOLOCK) ON creator.EmployeeId = reaction.CreatorId
		INNER JOIN #tblPerformanceRecord AS record ON record.IsDraft = 0
		AND reaction.PerformanceRecordId = record.PerformanceRecordId
	WHERE reaction.CreatorId = @ActorId
		OR @IsHost = 1
	ORDER BY reaction.CreatedDate ASC

	SELECT feedback.PRFeedbackId
		,feedback.PerformanceRecordId
		,feedback.Content
		,feedback.RoleId
		,feedback.CreatedDate
		,feedback.ModifiedDate
		,creator.EmployeeId
		,creator.Code
		,creator.FullName
		,creator.NickName
	FROM dbo.PRFeedback AS feedback WITH (NOLOCK)
		INNER JOIN dbo.Employee AS creator WITH (NOLOCK) ON creator.EmployeeId = feedback.CreatorId
		INNER JOIN #tblPerformanceRecord AS record ON record.IsDraft = 0
		AND feedback.PerformanceRecordId = record.PerformanceRecordId
	WHERE feedback.CreatorId = @ActorId
		OR @IsHost = 1
	ORDER BY feedback.CreatedDate ASC

	SELECT reaction.PRFeedbackReactionId
		,reaction.PRFeedbackId
		,reaction.CreatorId
		,reaction.RoleId
		,reaction.CreatedDate
		,creator.EmployeeId
		,creator.Code
		,creator.FullName
		,creator.NickName
	FROM dbo.PRFeedbackReaction AS reaction WITH (NOLOCK)
		INNER JOIN dbo.Employee AS creator WITH (NOLOCK) ON creator.EmployeeId = reaction.CreatorId
		INNER JOIN PRFeedback AS feedback WITH (NOLOCK) ON feedback.PRFeedbackId = reaction.PRFeedbackId
		INNER JOIN #tblPerformanceRecord AS record ON record.IsDraft = 0
		AND feedback.PerformanceRecordId = record.PerformanceRecordId
	WHERE reaction.CreatorId = @ActorId
		OR feedback.CreatorId = @ActorId
		OR @IsHost = 1
	ORDER BY reaction.CreatedDate ASC

	DROP TABLE #tblPerformanceRecord
END

GO