/*
EXEC [dbo].[SyncTOEIC_Import]    
    @TOEICXml ='<ROOT>
    <TOEIC EmpId='1' MinimumScore='600' Listening='300' Reading='300' 
        LRExamDate='2024-03-20' InputDate='2024-03-20' ModifiedDate='2024-03-20'></TOEIC>
