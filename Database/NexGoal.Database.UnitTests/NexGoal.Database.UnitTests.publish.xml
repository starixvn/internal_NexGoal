    <TargetDatabaseName>NexGoal.Database.UnitTests</TargetDatabaseName>
    <DeployScriptFileName>NexGoal.Database.UnitTests.sql</DeployScriptFileName>
    <ProfileVersionNumber>1</ProfileVersionNumber>
  </PropertyGroup>
  <ItemGroup>
    <SqlCmdVariable Include="NexBot">
      <Value>NexBot.Database</Value>
