    <SqlCmdVariable Include="NexGoal">
      <Value>NexGoal.Database</Value>
    </SqlCmdVariable>
    <SqlCmdVariable Include="NexHRM">
      <Value>NexHR.Database</Value>
    </SqlCmdVariable>
    <SqlCmdVariable Include="Redmine">
      <Value>Redmine.Database</Value>
    </SqlCmdVariable>
  </ItemGroup>
</Project>