@using NexGoal.Core.Enumerations
@using NexGoal.Core.Models
@using NexGoal.ViewModels.Function

@model AssignPermissionViewModel

@{
    var disabled = Model.IsHost ? string.Empty : "disabled";
}

@foreach (FunctionModel function in Model.Functions)
{
    <tr class="@(function.Level == 0 ? "row-special" : string.Empty)">
        @if (function.Level == 0)
        {
            <td class="level-first">
                <span class="icon-ui icon-level-first"></span>
                <span class="func-name">@function.Name</span>
            </td>
        }
        else
        {
            <td>
                @for (int i = 0; i < function.Level - 1; i++)
                {
                    <span class="icon-root_tree icon-level-second" style="visibility: hidden"></span>
                }
                <span class="icon-root_tree icon-level-second"></span>
                <span class="func-name">@function.Name</span>
            </td>
        }

        @{
            var permission = Model.RolePermissions.FirstOrDefault(x => x.FunctionId == function.FunctionId);
        }
        <td class="text-center">
            <label>
                <input type="checkbox" name="criteria.funcRead" id="funcRead@(function.FunctionId)"
                       data-pid="@function.ParentId" data-fid="@function.FunctionId"
                       @(permission != null && permission.Policy > Policy.None ? "checked" : string.Empty) @disabled />
            </label>
        </td>
        <td class="text-center">
            <label>
                <input type="checkbox" name="criteria.funcHost" id="funcHost@(function.FunctionId)"
                       data-pid="@function.ParentId" data-fid="@function.FunctionId"
                       @(permission != null && permission.Policy == Policy.Host ? "checked" : string.Empty) @disabled />
            </label>
        </td>
    </tr>

    var model = new AssignPermissionViewModel
    {
        RoleId = Model.RoleId,
        Functions = function.Childs.OrderBy(x => x.Level),
        RolePermissions = Model.RolePermissions,
        IsHost = Model.IsHost
    };

    @Html.Partial("_TreeFunction", model)
}