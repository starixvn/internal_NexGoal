@using NexGoal.Resources
@using NexGoal.ViewModels.EOQY
@model NominationManagementViewModel

@{
    ViewData["Title"] = ViewLang.NominationPeriod;
}

@section Styles {
    <link rel="stylesheet" href="~/dist/styles/nomination-period.css" asp-append-version="true" />
}

<input type="checkbox" hidden id="IsHost" @(Model.IsHost ? "checked" : string.Empty) />
<input type="hidden" id="ActiveTab" value="@Model.ActiveTab" />

<div id="nomination-wrapper"></div>

@section Scripts{
    <script src="~/dist/js/nomination-period.js" asp-append-version="true"></script>
}