@using NexGoal.Resources
@model int

@{
    ViewData["Title"] = ViewLang.NominationManagement;
    bool isHost = (bool)ViewData["IsHost"];
}

@section Styles {
    <link rel="stylesheet" href="~/dist/styles/editeoqy.css" />
}

<input type="hidden" id="EOYId" value="@Model" />
<input type="checkbox" hidden id="IsHost" @(isHost ? "checked" : string.Empty) />

<div id="nomination-wrapper"></div>

@section Scripts{
    <script src="~/dist/js/editeoy.js"></script>
}