<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="shortcut icon" type="image/ico" href="~/favicon.ico" />

    <link href="~/dist/styles/main.css" rel="stylesheet" />

    @RenderSection("Styles", false)
</head>
<body>
    @await Component.InvokeAsync("Menu")
    <div class="container-fluid page">
        <div class="row main">
            <div class="section-wrap">
                <div id="main-container" class="section-body">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()
    @Html.Hidden("RootURL", Url.Content("~/"))

    <script src="~/dist/resources/resource_en_US.js" asp-append-version="true"></script>
    <script src="~/dist/vendors/react.js" asp-append-version="false"></script>
    <script src="~/dist/js/main.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>