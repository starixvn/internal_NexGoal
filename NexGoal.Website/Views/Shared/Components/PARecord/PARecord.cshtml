@using NexGoal.Models.PARecord
@model PAProcessModel

@if (Model.PerformanceRecord != null)
{
    <div class="record">
        <div class="avatar-user">
            <img src=@Model.Evaluator.Avatar class="avatar" />
            <div class="person-info">
                <span class="role-member">@Model.Evaluator.NickName</span>
                @if (Model.Evaluator.EmployeeId != Model.PerformanceRecord.Creator.EmployeeId)
                {
                    <span class="icon-checkin"></span>
                    <span class="role-member">Member</span>
                }
                @{
                    var submitDate = Model.PerformanceRecord.CreatedDate != null ?
                        Model.PerformanceRecord.CreatedDate.ToString("dd MMM yyyy") : "";
                }
                <div class="submit-date">@submitDate</div>
            </div>
        </div>
        @{
            var grade = Model.PerformanceRecord.Grade != null ?
           $"({Model.PerformanceRecord.Grade.Name }) {Model.PerformanceRecord.Grade.Description}" : "N/A";
        }

        <div class="comment">
            <p>@Model.PerformanceRecord.Comment</p>
        </div>
        <div class="grade">Grade: <div class="grade-detail">@grade</div></div>
    </div>
}