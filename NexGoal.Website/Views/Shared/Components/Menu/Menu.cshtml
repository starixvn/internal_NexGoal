@using NexGoal.Models.Auth
@using NexGoal.Models.Common
@model IEnumerable<MenuItemSession>

@{
    var employee = (Employee)ViewData["employee"];
    var currentController = ViewContext.RouteData.Values["Controller"].ToString().ToLowerInvariant();
    var currentAction = ViewContext.RouteData.Values["Action"].ToString().ToLowerInvariant();
    var currentUrl = string.Format("/{0}/{1}", currentController, currentAction);
}

<nav class="navbar navbar-inverse navbar-fixed-top">
    <div class="pull-left left-bar">
        <a class="navbar-brand" asp-controller="home" asp-action="index">
            <img src="~/sources/styles/images/nexgoal.svg" />
        </a>
    </div>
    <div class="pull-left nav-hamberger">
        @if (Model != null && Model.Any())
        {
            <ul class="nav navbar-nav">
                @foreach (MenuItemSession menuGroup in Model)
                {
                    @if (menuGroup.Childs.Any())
                    {
                        var dropdownId = string.Format("dropdownMenu{0}", menuGroup.MenuId);
                        <li class="dropdown @(menuGroup.Childs.Any(c => currentUrl.Equals(c.Link.ToLowerInvariant(), StringComparison.CurrentCultureIgnoreCase)) ? "active" : string.Empty)">
                            <a href="#" id="@dropdownId" class="dropdown-toggle"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                @menuGroup.Name <span class="icon-chevron-down"></span>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="@dropdownId">
                                @foreach (MenuItemSession child in menuGroup.Childs)
                                {
                                    <li class="@(currentUrl.Equals(child.Link.ToLowerInvariant(),  StringComparison.CurrentCultureIgnoreCase) ? "active" : string.Empty)">
                                        <a href="@child.Link">@child.Name</a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="@(currentUrl.Equals(menuGroup.Link.ToLowerInvariant(),  StringComparison.CurrentCultureIgnoreCase) ? "active" : string.Empty)">
                            <a href="@menuGroup.Link">@menuGroup.Name</a>
                        </li>
                    }
                }
            </ul>
        }
    </div>

    <div class="auth-info pull-right">
        <div id="search-member-wrapper" class="search-member-wrapper"></div>
        <div id="notification" class="search-member-wrapper"></div>
        <span class="user-avatar">
            <img alt="Avatar" src="@employee.Avatar" />
        </span>
    </div>
</nav>

<div class="hide" id="currentUserInfo">
    <span id="employeeInfo-fullName">@employee.FullName</span>
    <span id="employeeInfo-nickName">@employee.NickName</span>
    <span id="employeeInfo-jobTitle">@employee.JobTitle</span>
    <img id="employeeInfo-avatar" src="@employee.Avatar" />
    <input type="checkbox" id="employeeInfo-isProbation" @(employee.IsProbation ? "checked" : string.Empty) />
</div>