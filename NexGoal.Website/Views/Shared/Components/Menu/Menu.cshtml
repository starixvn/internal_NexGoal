@using NexGoal.ViewModels.Auth
@model HeaderViewModel

@{
    var employee = Model.UserInfo;
}

<nav class="navbar navbar-inverse navbar-fixed-top">
    <div class="pull-left left-bar">
        <a class="navbar-brand" asp-controller="home" asp-action="index">
            <img src="~/sources/styles/images/@Model.LogoName" alt="@Model.LogoName" />
        </a>
    </div>

    <div id="menu-wrapper"></div>

    <div class="auth-info pull-right">
        <div id="search-member-wrapper" class="search-member-wrapper"></div>
        <div id="notification" class="search-member-wrapper"></div>
        <div class="user-avatar">
            <img alt="Avatar" src="@($"{Model.ImageUrl}/{employee.Code}.jpg")" />
            <ul class="dropdown-menu">
                <li><a href="@Url.Action("Logout", "Auth")">Log out</a></li>
            </ul>
        </div>
    </div>
</nav>

<div class="hide" id="currentUserInfo">
    <span id="employeeInfo-fullName">@employee.FullName</span>
    <span id="employeeInfo-nickName">@employee.NickName</span>
    <span id="employeeInfo-jobTitle">@employee.JobTitle</span>
    <span id="employeeInfo-unreadNoti">@Model.UnreadNotification</span>
    <img id="employeeInfo-avatar" src="@($"{Model.ImageUrl}/{employee.Code}.jpg")" alt="employee-avatar" />
    <input type="hidden" id="employeeInfo-groupname" value="@employee.GroupName" />
    <input type="hidden" id="employeeInfo-joineddate" value="@employee.JoinedDate" />
    <input type="checkbox" id="employeeInfo-isProbation" @(employee.IsProbation ? "checked" : string.Empty) />
    <input type="checkbox" id="employeeInfo-hasMember" @(Model.HasMember ? "checked" : string.Empty) />
    <input type="hidden" id="employeeInfo-code" value="@employee.Code" />
</div>