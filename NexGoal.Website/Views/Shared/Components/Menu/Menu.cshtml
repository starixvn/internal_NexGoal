@using NexGoal.Core.Models
@model IEnumerable<MenuItemSession>

@{ 
    var currentController = ViewContext.RouteData.Values["Controller"].ToString();
    var currentAction = ViewContext.RouteData.Values["Action"].ToString();
    var currentUrl = string.Format("/{0}/{1}", currentController, currentAction);
}

<nav class="navbar navbar-inverse navbar-fixed-top">
    <div class="pull-left left-bar" id="topNavigation">
        <a class="navbar-brand" asp-controller="home" asp-action="index">
            <img src="~/sources/styles/images/nexgoal.svg" />
        </a>
    </div>
    <div class="pull-left nav-hamberger">
        <a href="javascript:;" id="modifyMenuVisibility">
            <i class="fa fa-bars"></i>
        </a>
    </div>

    <div class="auth-info pull-right">
        <strong>@ViewData["FullName"] - @ViewData["NickName"]</strong>
        &nbsp;&nbsp;
        <span class="user-avatar">
            <img src="" />
        </span>
    </div>
</nav>

<div id="sidebar">
    <ul class="list-group">
        @if (Model != null && Model.Any())
        {
            IEnumerable<MenuItemSession> menuGroups = Model.Where(x => !x.ParentId.HasValue).OrderBy(x => x.DisplayOrder);

            foreach (MenuItemSession parent in menuGroups)
            {
                IEnumerable<MenuItemSession> childMenus = Model.Where(x => x.ParentId == parent.MenuId).OrderBy(x => x.DisplayOrder);

                <li class="list-group-item @(childMenus.Any() ? "has-sub" : "no-sub")">
                    @if (childMenus.Any())
                    {
                        <a class="sub-menu-title" data-toggle="collapse" data-target=".menu-@parent.MenuId">
                            <i class="fa fa-@parent.Description"></i>
                            <span>@parent.Name</span>
                            <i class="fa fa-chevron-down pull-right"></i>
                        </a>

                        <ul class="list-group menu-@parent.MenuId">
                            @foreach (MenuItemSession child in childMenus)
                            {
                                <li class="list-group-item sub-menu @(currentUrl.Equals(child.Link,  StringComparison.CurrentCultureIgnoreCase) ? "active" : string.Empty)">
                                    <a href="@child.Link">
                                        <span>@child.Name</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        if (!string.IsNullOrWhiteSpace(parent.Link))
                        {
                            <a href="@parent.Link">
                                <i class="fa fa-@parent.Description"></i>
                                <span>@parent.Name</span>
                            </a>
                        }
                    }
                </li>
            }
        }
    </ul>
</div>