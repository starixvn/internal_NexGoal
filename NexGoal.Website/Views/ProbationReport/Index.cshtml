@using NexGoal.Resources

@model IEnumerable<int>

@{
    ViewData["Title"] = ViewLang.ProbationReport;
}

@section Styles {
    <link rel="stylesheet" href="~/dist/styles/probation-report.css" asp-append-version="true" />
}

<div id="probation-report-wrapper"></div>
<input id="roles" type="hidden" value="@string.Join(',', Model)" />

@section Scripts {
    <script src="~/dist/js/probation-report.js" asp-append-version="true"></script>
}