@using NexGoal.Resources
@model bool

@section Styles {
    <link rel="stylesheet" href="~/dist/styles/period.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = ViewLang.EvaluationPeriod;
}

<input type="checkbox" hidden @(Model ? "checked" : string.Empty) id="IsHost" />

<div id="period-wrapper"></div>

@section Scripts{
    <script src="~/dist/js/period.js" asp-append-version="true"></script>
}