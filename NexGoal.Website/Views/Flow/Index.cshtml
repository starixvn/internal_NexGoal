@using NexGoal.Resources
@using NexGoal.ViewModels.FlowTemplate
@model FlowTemplateViewModel

@{
    ViewData["Title"] = ViewLang.EvaluationFlow;
}

@section Styles {
    <link rel="stylesheet" href="~/dist/styles/evaluationflow.css" />
}

@Html.AntiForgeryToken()
<input type="hidden" asp-for="TargetTypeId" />
<input type="hidden" asp-for="IsActive" />
<input type="checkbox" hidden id="IsHost" @(Model.IsHost ? "checked" : string.Empty) />

<div id="evaluationflow-wrapper"></div>

@section Scripts{
    <script src="~/dist/js/evaluationflow.js"></script>
}