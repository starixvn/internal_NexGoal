@using NexGoal.Resources

@{
    ViewData["Title"] = ViewLang.EvaluationFlow;
    bool isHost = (bool)ViewData["IsHost"];
}

@section Styles {
    <link rel="stylesheet" href="~/dist/styles/evaluationflow.css" asp-append-version="true" />
}

<input type="checkbox" hidden id="IsHost" @(isHost ? "checked" : string.Empty) />

<div id="evaluationflow-wrapper"></div>

@section Scripts{
    <script src="~/dist/js/evaluationflow.js" asp-append-version="true"></script>
}