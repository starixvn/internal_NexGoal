@using NexGoal.Models.Report
@model PAReportDetail

@{ 
    var avatar = "https://hrm.nexcel.vn/Avatars/02242.jpg";
}

<html>
<head>
    <link rel="stylesheet" type="text/css" href="~/dist/styles/paDetail-pdf.css" />
</head>
<body>
    <div class="pa-pdf">
        <div class="title">Performance appraisal of @Model.Employee.NickName (@Model.PARecord.Period.Name)</div>
        <div class="box">
            <div class="title">Information Profile</div>
            <div class="content info">
                <div class="section">
                    <div class="item"><span class="key">Staff code:</span><span class="value">@Model.Employee.Code</span></div>
                    <div class="item"><span class="key">Nickname:</span><span class="value">@Model.Employee.NickName</span></div>
                    <div class="item"><span class="key">Job title:</span><span class="value">@Model.Employee.JobTitle</span></div>
                    <div class="item"><span class="key">Department:</span><span class="value">Software Development</span></div>
                </div>
                <div class="section">
                    <div class="item"><span class="key">Full name:</span><span class="value">@Model.Employee.FullName</span></div>
                    <div class="item"><span class="key">Team:</span><span class="value">@Model.Employee.GroupName</span></div>
                    <div class="item"><span class="key">Joined date:</span><span class="value"></span></div>
                </div>
            </div>
        </div>
        <div class="box">
            <div class="title">Approach To Work</div>
            <div class="content">
                <div class="sub-box">
                    <div class="title">A. HRM System</div>
                    <div class="sub-content">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Month</th>
                                    <th>Missing Check In/Out</th>
                                    <th>Late In</th>
                                    <th>Early Out</th>
                                    <th>Unpaid Leave</th>
                                    <th>Unplanned Annual Leave</th>
                                    <th>Average Working Hours</th>
                                    <th>Overtime</th>
                                    <th>Toiec</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-center">6/2018</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">8h15'</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center" rowspan="6">665 (exp 27 Nov 2019)</td>
                                </tr>
                                <tr>
                                    <td class="text-center">7/2018</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">8h15'</td>
                                    <td class="text-center">0</td>
                                </tr>
                                <tr>
                                    <td class="text-center">8/2018</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">8h15'</td>
                                    <td class="text-center">0</td>
                                </tr>
                                <tr>
                                    <td class="text-center">9/2018</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">8h15'</td>
                                    <td class="text-center">0</td>
                                </tr>
                                <tr>
                                    <td class="text-center">10/2018</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">8h15'</td>
                                    <td class="text-center">0</td>
                                </tr>
                                <tr>
                                    <td class="text-center">11/2018</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">8h15'</td>
                                    <td class="text-center">0</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td class="text-center">Total</td>
                                    <td class="text-center">1</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">2</td>
                                    <td class="text-center">2</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center">8h15'</td>
                                    <td class="text-center">0</td>
                                    <td class="text-center"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="sub-box">
                    <div class="title">B. Disciplines</div>
                    <div class="sub-content">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Remark</th>
                                    <th>Issue Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Disciplines.Any())
                                {
                                    var index = 0;
                                    foreach (var discipline in Model.Disciplines)
                                    {
                                        index++;
                                        <tr>
                                            <td class="text-center">@index</td>
                                            <td class="text-center">@discipline.Description</td>
                                            <td class="text-center">@discipline.EffectiveDate</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center">No Record Found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="box">
            <div class="title">Performance Records</div>
            <div class="content">
                <div class="sub-box">
                    <div class="title">A. Achievements</div>
                    <div class="sub-content">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Achievements.Any())
                                {
                                    var index = 0;
                                    foreach (var achievement in Model.Achievements)
                                    {
                                        index++;
                                        string statusClass = string.Format("status-{0}",
                                            achievement.StatusId.ToString().ToLowerInvariant());
                                        <tr>
                                            <td>@index</td>
                                            <td>@achievement.Period.Title</td>
                                            <td class="@statusClass">@achievement.StatusId.ToString()</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center">No Record Found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="sub-box">
                    <div class="title">B. Performance Summary</div>
                    <div class="sub-box performance-sum">
                        <div class="title">1. Self</div>
                        <div class="sub-content">
                            <div class="record">

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>