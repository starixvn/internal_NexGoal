@using NexGoal.Models.Common
@using NexGoal.Core.Models
@inject AppSettings appSettings
@model Employee

@{
    ViewData["Title"] = Model.NickName + " Page";
}

@section Styles {
    <link rel="stylesheet" href="~/dist/styles/member-details.css" asp-append-version="true" />
}

<input type="hidden" id="MemberId" value="@Model.EmployeeId" />
<input type="hidden" id="member-fullName" value="@Model.FullName" />
<input type="hidden" id="member-nickName" value="@Model.NickName" />
<input type="hidden" id="member-jobTitle" value="@Model.JobTitle" />
<input type="hidden" id="member-avatar" value="@($"{appSettings.ImageUrl}/{Model.Code}.jpg")" />
<input type="checkbox" hidden id="member-isProbation" @(Model.IsProbation ? "checked" : string.Empty) />

<div id="member-wrapper"></div>

@section Scripts{
    <script type="text/javascript" src="~/dist/js/member-details.js" asp-append-version="true"></script>
}