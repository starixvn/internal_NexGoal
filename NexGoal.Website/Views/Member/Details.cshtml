@using NexGoal.Models.Common
@model EmployeeBaseModel

@{
    ViewData["Title"] = Model.NickName + " Page";
}

@section Styles {
    <link rel="stylesheet" href="~/dist/styles/member-index.css" />
}

<input type="hidden" id="MemberId" value="@Model.EmployeeId" />
<input type="hidden" id="member-fullName" value="@Model.FullName" />
<input type="hidden" id="member-nickName" value="@Model.NickName" />
<input type="hidden" id="member-jobTitle" value="@Model.JobTitle" />
<input type="hidden" id="member-avatar" value="@Model.Base64Image" />
<input type="radio" hidden id="isNominator" checked=@ViewData["IsNominator"] />

<div id="member-wrapper"></div>

@section Scripts{
    <script type="text/javascript" src="~/dist/js/member-details.js"></script>
}