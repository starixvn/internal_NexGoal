@model object
@section Styles {
    <link rel="stylesheet" href="~/dist/styles/member-index.css" />
}

@{
    ViewData["Title"] = "Members Page";
    bool isNominator = (bool)ViewData["IsNominator"];
    bool isReviewer = (bool)ViewData["IsReviewer"];

}
<input type="radio" hidden id="isNominator" checked=@isNominator readonly />
<input type="radio" hidden id="isReviewer" checked=@isReviewer readonly />

<div id="member-wrapper"></div>

@section Scripts{
    <script type="text/javascript" src="~/dist/js/member-index.js" asp-append-version="true"></script>
}