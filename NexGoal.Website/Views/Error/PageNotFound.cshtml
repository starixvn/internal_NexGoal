@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found</title>
    <link rel="shortcut icon" type="image/ico" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
    <link href="~/dist/styles/error.css" rel="stylesheet" />
</head>
<body>
    <div class="page-error page-error-404">
        <div class="page-content vertical-align-middle">
            <header>
                <div class="img-block">
                    <img class="img-main" src="~/sources/styles/images/404/404.svg" alt="404.svg" />
                    <img class="balloon" src="~/sources/styles/images/404/balloon.svg" alt="balloon.svg" />
                    <img class="small-cloud" src="~/sources/styles/images/404/cloud-small.svg" alt="cloud-small.svg" />
                    <img class="big-cloud" src="~/sources/styles/images/404/cloud-big.svg" alt="cloud-big.svg" />
                    <img class="wind-bottom" src="~/sources/styles/images/404/wind.svg" alt="wind.svg" />
                    <img class="wind-top" src="~/sources/styles/images/404/wind.svg" alt="wind.svg" />
                </div>
            </header>
            <p class="error-advise">Oops. The page you are looking for doesn't exist.</p>
            <a class="cta" asp-controller="home" asp-action="index">
                <span class="icon-back"></span> Take me back to the dashboard
            </a>
        </div>
    </div>
</body>
</html>