@{
    Layout = null;
}

@section Styles {
    <link rel="stylesheet" href="~/dist/styles/error.css" />
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Internal Error</title>
    <link rel="shortcut icon" type="image/ico" href="~/favicon.ico" />

    <link href="~/dist/styles/error.css" rel="stylesheet" />
</head>
<body>
    <div class="page-error page-error-500">
        <div class="page-content vertical-align-middle">
            <header>
                <div class="img-block">
                    <img src="~/sources/styles/images/500/desktop.svg" />
                    <div class="screen">
                        <img src="~/sources/styles/images/500/bluscreen.svg" />
                        <img class="error" src="~/sources/styles/images/500/Error.svg" />
                    </div>
                    <img class="leave" src="~/sources/styles/images/500/leave.svg" />
                </div>
            </header>
            <p class="big-text">500</p>
            <p class="error-advise text-uppercase">internal error</p>
            <p class="small-text">Oh dear, it looks like something went wrong. We'll take a look at that shortly.</p>
            <a class="cta" asp-controller="home" asp-action="index">
                <i class="icon fa fa-long-arrow-left" aria-hidden="true"></i>Take me back to the dashboard
            </a>
        </div>
    </div>
</body>
</html>
