@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied</title>
    <link rel="shortcut icon" type="image/ico" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
    <link href="~/dist/styles/error.css" rel="stylesheet" />
</head>
<body>
    <div class="page-error page-error-405">
        <div class="page-content vertical-align-middle">
            <header>
                <div class="img-block">
                    <img class="door" src="~/sources/styles/images/405/door.svg" />
                    <div class="seal-slideshow">
                        <div class="mover-1"></div>
                    </div>

                    <img class="signage" src="~/sources/styles/images/405/signage.svg" />
                </div>
            </header>
            <p class="error-advise">Oops. 405, ACCESS DENIED</p>
            <p class="margin-bottom-30 font-size-16">
                Sorry about that, but you don't have permission to access this page.
            </p>
            <a class="cta" asp-controller="home" asp-action="index">
                <i class="icon fa fa-long-arrow-left" aria-hidden="true"></i>Take me back to the dashboard
            </a>
        </div>
    </div>
</body>
</html>
