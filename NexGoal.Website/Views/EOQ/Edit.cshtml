@using NexGoal.Resources
@model int

@{
    ViewData["Title"] = ViewLang.NominationPeriod;
    bool isHost = (bool)ViewData["IsHost"];
}

@section Styles {
    <link rel="stylesheet" href="~/dist/styles/editeoqy.css" asp-append-version="true" />
}

<input type="hidden" id="EOQId" value="@Model" />
<input type="checkbox" hidden id="IsHost" @(isHost ? "checked" : string.Empty) />

<div id="nomination-wrapper"></div>

@section Scripts{
    <script src="~/dist/js/editeoq.js" asp-append-version="true"></script>
}