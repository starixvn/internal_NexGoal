@using NexGoal.Resources
@using NexGoal.Core.Enumerations
@using NexGoal.Models.PerformanceRecord
@using NexGoal.Models.PRFeedback
@model PerformanceRecord

@{
    string getRoleClass(int roleId)
    {
        var roleClass = string.Empty;
        switch (roleId)
        {
            case (byte)PerformanceProcess.Self:
                roleClass = "role-member";
                break;

            case (byte)PerformanceProcess.Evaluator:
                roleClass = "role-evaluator";
                break;

            case (byte)PerformanceProcess.ProjectManager:
                roleClass = "role-pm";
                break;

            case (byte)PerformanceProcess.Reviewer:
                roleClass = "role-reviewer";
                break;

            default:
                roleClass = "role-member";
                break;
        }

        return roleClass;
    }
}

@if (Model != null)
{
    <div class="record">
        <div class="avatar-user">
            <img src=@Model.Creator.Avatar class="avatar" alt="avatar" />
            <div class="person-info">
                <span class="@getRoleClass(Model.RoleId)">@Model.Creator.NickName</span>
            </div>
        </div>
        @{
            var grade = Model.Grade != null ? $"({Model.Grade.Name}) {Model.Grade.Description}" : ViewLang.NA;
        }
        <div class="date-time"></div>
        <div class="comment">
            <p>@Model.Comment</p>
        </div>
        <div class="grade">@ViewLang.Grade: <div class="grade-detail">@grade</div></div>
        @if (Model.Reactions.Any() || Model.Feedbacks.Any())
        {
            <div class="interaction">
                @{var creator = string.Join(", ", Model.Reactions.Select(x => x.Creator.NickName));}
                <div class="reaction">
                    <strong>@creator</strong> liked this PR.
                </div>
                @foreach (PRFeedbackModel feedback in Model.Feedbacks)
                {
                    <div class="feedback">
                        <strong>@feedback.Creator.NickName</strong> commented:
                        <br />
                        @feedback.Content
                    </div>
                }
            </div>
        }
    </div>
}