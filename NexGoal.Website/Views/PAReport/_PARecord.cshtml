@using NexGoal.Resources
@using NexGoal.Core.Enumerations
@using NexGoal.Models.PerformanceRecord
@model PerformanceRecord

@if (Model != null)
{
    <div class="record">
        <div class="avatar-user">
            <img src=@Model.Creator.Avatar class="avatar" alt="avatar" />
            <div class="person-info">
                @{
                    string roleClass = "";
                    switch (Model.RoleId)
                    {
                        case (byte)PerformanceProcess.Self:
                            roleClass = "role-member";
                            break;

                        case (byte)PerformanceProcess.Evaluator:
                            roleClass = "role-evaluator";
                            break;

                        case (byte)PerformanceProcess.ProjectManager:
                            roleClass = "role-pm";
                            break;

                        case (byte)PerformanceProcess.Reviewer:
                            roleClass = "role-reviewer";
                            break;

                        default:
                            roleClass = "role-member";
                            break;
                    }
                }
                <span class="@roleClass">@Model.Creator.NickName</span>
            </div>
        </div>
        @{
            var grade = Model.Grade != null ? $"({Model.Grade.Name}) {Model.Grade.Description}" : ViewLang.NA;
        }
        <div class="comment">
            <p>@Model.Comment</p>
        </div>
        <div class="grade">@ViewLang.Grade: <div class="grade-detail">@grade</div></div>
    </div>
}