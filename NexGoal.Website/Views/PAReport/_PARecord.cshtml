@using NexGoal.Core.Enumerations
@using NexGoal.Core.Models
@using NexGoal.Models.PRFeedback
@using NexGoal.Models.PerformanceRecord
@inject AppSettings appSettings
@model PerformanceRecord

@{
    string GetRoleClass(int roleId)
    {
        var roleClass = roleId switch
        {
            (byte)PerformanceProcess.Self => "role-member",
            (byte)PerformanceProcess.Evaluator => "role-evaluator",
            (byte)PerformanceProcess.ProjectManager => "role-pm",
            (byte)PerformanceProcess.Reviewer => "role-reviewer",
            _ => "role-member"
        };

        return roleClass;
    }

    void RenderFeedback(PRFeedbackModel feedback)
    {
        <div class="feedback">
            <strong>@feedback.Creator.NickName</strong> commented:
            <br />
            <p>@feedback.Content</p>

            @if (feedback.Reactions.Any())
            {
                var creator = string.Join(", ", feedback.Reactions.Select(x => x.Creator.NickName));

                <br />
                <span><strong>@creator</strong> liked this comment.</span>
            }
        </div>
    }
}

@if (Model != null)
{
    <div class="record">
        <div class="avatar-user">
            <img src="@($"{appSettings.ImageUrl}/{Model.Creator.Code}.jpg")" class="avatar" alt="avatar" />
            <div class="person-info">
                <div class="@GetRoleClass(Model.RoleId)">@Model.Creator.NickName</div>
                <div>
                    @(Model.CreatedDate.HasValue
                            ? $"{Model.CreatedDate.Value:dd MMM yyyy} at {Model.CreatedDate.Value:HH:mm}"
                            : string.Empty)
                </div>
            </div>
        </div>
        @{
            var grade = Model.Grade != null ? $"({Model.Grade.Name}) {Model.Grade.Description}" : ViewLang.NA;
        }
        <div class="date-time"></div>
        <div class="comment">
            <p>@Model.Comment</p>
        </div>
        <div class="grade">@ViewLang.Grade: <div class="grade-detail">@grade</div></div>
        @if (Model.Reactions.Any() || Model.Feedbacks.Any())
        {
            <div class="interaction">
                @{var creator = string.Join(", ", Model.Reactions.Select(x => x.Creator.NickName));}
                <div class="reaction">
                    <strong>@creator</strong> liked this PR.
                </div>
                @foreach (var feedback in Model.Feedbacks)
                {
                    RenderFeedback(feedback);
                }
            </div>
        }
    </div>
}