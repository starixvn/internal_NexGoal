    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="./lib/wkhtmlox/64/libwkhtmltox.dll" Link="libwkhtmltox.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="./lib/wkhtmlox/64/libwkhtmltox.so" Link="libwkhtmltox.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="9.21.0.86780">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NexGoal.Controllers\NexGoal.Controllers.csproj" />
    <ProjectReference Include="..\NexGoal.Models\NexGoal.Models.csproj" />
  </ItemGroup>
  <Target Name="CreateLogsFolder" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Logs" Condition="!Exists('$(PublishDir)Logs')" />
  </Target>
</Project>