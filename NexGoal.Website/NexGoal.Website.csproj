    </Content>
    <Content Include="EmailTemplates\PCI\Create\SupervisorToSupervisor.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\PCI\Edit\MemberToSupervisor.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\PCI\Edit\SupervisorToMember.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\PCI\Edit\SupervisorToSupervisor.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\Probation\RemindToEvaluator.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\Probation\StartToEvaluator.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
