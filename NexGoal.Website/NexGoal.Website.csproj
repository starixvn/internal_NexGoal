<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <CodeAnalysisRuleSet>NexGoal.Website.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <CodeAnalysisRuleSet>NexGoal.Website.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="App_Data\SPNames.xml" />
    <None Remove="EmailTemplates\Nomination\RemindToNominator.txt" />
    <None Remove="EmailTemplates\Nomination\StartToNominator.txt" />
    <None Remove="EmailTemplates\PAFocus\RemindToEvaluator.txt" />
    <None Remove="EmailTemplates\PAFocus\StartToEvaluator.txt" />
    <None Remove="EmailTemplates\PA\EndToSelf.txt" />
    <None Remove="EmailTemplates\PA\RemindStartToSelf.txt" />
    <None Remove="EmailTemplates\PA\RemindStartToSupervisor.txt" />
    <None Remove="EmailTemplates\PA\RemindToReviewer.txt" />
    <None Remove="EmailTemplates\PA\StartToReviewer.txt" />
    <None Remove="EmailTemplates\PCI\Create\MemberToSupervisor.txt" />
    <None Remove="EmailTemplates\PCI\Create\SupervisorToMember.txt" />
    <None Remove="EmailTemplates\PCI\Create\SupervisorToSupervisor.txt" />
    <None Remove="EmailTemplates\PCI\Edit\MemberToSupervisor.txt" />
    <None Remove="EmailTemplates\PCI\Edit\SupervisorToMember.txt" />
    <None Remove="EmailTemplates\PCI\Edit\SupervisorToSupervisor.txt" />
    <None Remove="EmailTemplates\Probation\RemindToEvaluator.txt" />
    <None Remove="EmailTemplates\Probation\StartToEvaluator.txt" />
    <None Remove="EmailTemplates\Probation\StartToHR.txt" />
    <None Remove="EmailTemplates\Probation\StartToMember.txt" />
    <None Remove="ExcelTemplates\MasterReport.xlsx" />
    <None Remove="ExcelTemplates\PAFocus.xlsx" />
    <None Remove="ExcelTemplates\PAReport.xlsx" />
    <None Remove="ExcelTemplates\ProbationReport.xlsx" />
    <None Remove="logs\log.txt" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="..\SonarQube\nexgoal\CSharp\SonarLint.xml" Link="SonarLint.xml" />
    <Content Include="App_Data\SPNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\Nomination\RemindToNominator.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\Nomination\StartToNominator.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\PAFocus\RemindToEvaluator.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\PAFocus\StartToEvaluator.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\PA\EndToSelf.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\PA\RemindStartToSelf.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\PA\RemindStartToSupervisor.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\PA\RemindToReviewer.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\PA\StartToReviewer.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\PCI\Create\MemberToSupervisor.txt">
