<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>netcoreapp2.1</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <CodeAnalysisRuleSet>NexGoal.Website.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <CodeAnalysisRuleSet>NexGoal.Website.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="App_Data\SPNames.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\SPNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fanex.Data" Version="3.0.0-rc1" />
    <PackageReference Include="Microsoft.AspNetCore" Version="2.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication" Version="2.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.CookiePolicy" Version="2.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.HttpsPolicy" Version="2.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Routing" Version="2.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Session" Version="2.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="2.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="11.0.2" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="7.2.0.5463" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
    <Folder Include="Models\" />
    <Folder Include="wwwroot\assets\styles\fonts\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\assets\styles\abstracts\_mixins.scss" />
    <None Include="wwwroot\assets\styles\abstracts\_variables.scss" />
    <None Include="wwwroot\assets\styles\images\404\404.svg" />
    <None Include="wwwroot\assets\styles\images\404\balloon.svg" />
    <None Include="wwwroot\assets\styles\images\404\cloud-big.svg" />
    <None Include="wwwroot\assets\styles\images\404\cloud-small.svg" />
    <None Include="wwwroot\assets\styles\images\404\wind.svg" />
    <None Include="wwwroot\assets\styles\images\405\door.svg" />
    <None Include="wwwroot\assets\styles\images\405\seal.svg" />
    <None Include="wwwroot\assets\styles\images\405\short-seal.svg" />
    <None Include="wwwroot\assets\styles\images\405\signage.svg" />
    <None Include="wwwroot\assets\styles\images\500\bluscreen.svg" />
    <None Include="wwwroot\assets\styles\images\500\desktop.svg" />
    <None Include="wwwroot\assets\styles\images\500\Error.svg" />
    <None Include="wwwroot\assets\styles\images\500\leave.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexGoal.Controllers\NexGoal.Controllers.csproj" />
    <ProjectReference Include="..\NexGoal.Core\NexGoal.Core.csproj" />
    <ProjectReference Include="..\NexGoal.Resources\NexGoal.Resources.csproj" />
    <ProjectReference Include="..\NexGoal.Services\NexGoal.Services.csproj" />
  </ItemGroup>

  <Target Name="CreateLogsFolder" AfterTargets="AfterPublish">
    <MakeDir Directories="$(PublishDir)logs" Condition="!Exists('$(PublishDir)logs')" />
    <MakeDir Directories="$(PublishUrl)logs" Condition="!Exists('$(PublishUrl)logs')" />
  </Target>

</Project>
